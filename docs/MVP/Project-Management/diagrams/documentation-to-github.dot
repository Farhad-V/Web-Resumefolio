digraph Tracking {
graph [rankdir=TB,bgcolor="#0b1220",fontname="Arial",fontcolor="#e5edf7",label="Define in Documentation, track in GitHub",labelloc=t,fontsize=23,pad="0.4",nodesep="0.5",ranksep="0.5"];
node [shape=box,style="rounded,filled",fillcolor="#172f4b",color="#6ba7ef",fontname="Arial",fontcolor="#e5edf7",fontsize=13,margin="0.2,0.16"];
edge [color="#91a8c2",fontcolor="#b6c7dc",fontname="Arial",fontsize=11];
baseline [label="Baseline\nSelected scope, criteria and Design"];
milestones [label="SDLC / Project Planning\nCanonical Milestone outcomes\nand completion conditions"];
backlog [label="Project Management\nBacklog definitions + dependencies"];
githubm [label="GitHub Milestones\nGroup Issues by outcome",fillcolor="#103b35",color="#49c5ad"];
issues [label="GitHub Issues\nActual tasks, blockers and evidence",fillcolor="#103b35",color="#49c5ad"];
board [label="GitHub Kanban\nBacklog / In Progress / Done\nFuture scope in After MVP view",fillcolor="#103b35",color="#49c5ad"];
baseline -> milestones;baseline -> backlog;
milestones -> githubm [label="Same IDs + source links"];
backlog -> issues [label="Reuse existing PBIs"];
githubm -> issues [label="Milestone assignment"];
issues -> board [label="One live status"];
note [label="No active Sprint / Iteration planning\nNo invented deadlines or completion",shape=note,fillcolor="#29253d",color="#b29be5"];
board -> note [style=dashed,arrowhead=none];
}
