graph domain {
graph [rankdir=LR,bgcolor="white",pad="0.35",nodesep="0.5",ranksep="0.9",splines=polyline,fontname="Segoe UI",fontsize=15];node [shape=plain,fontname="Segoe UI"];edge [fontname="Segoe UI",fontsize=10,color="#547083",fontcolor="#344f61",penwidth=1.15];
resume [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Tailored resume</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C03 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Content selection<BR ALIGN="LEFT"/>layout<BR ALIGN="LEFT"/>tailoring context</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Compose<BR ALIGN="LEFT"/>apply selected changes<BR ALIGN="LEFT"/>request publication</FONT></TD></TR></TABLE>>];
publication [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Published presentation</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C09 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Effective content/revision context</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Confirm publication<BR ALIGN="LEFT"/>expose selected content</FONT></TD></TR></TABLE>>];
generated [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Generated resume PDF</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C10 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Represented content<BR ALIGN="LEFT"/>language<BR ALIGN="LEFT"/>availability</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Request generation<BR ALIGN="LEFT"/>report availability</FONT></TD></TR></TABLE>>];
uploaded [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Uploaded resume PDF</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C11 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Artifact identity<BR ALIGN="LEFT"/>language<BR ALIGN="LEFT"/>availability</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Admit<BR ALIGN="LEFT"/>replace under validation</FONT></TD></TR></TABLE>>];
download [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>PDF download availability</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C12 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Mode<BR ALIGN="LEFT"/>language eligibility</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Change download configuration</FONT></TD></TR></TABLE>>];
link [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Protected employer link</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C13 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Target context<BR ALIGN="LEFT"/>access state<BR ALIGN="LEFT"/>credential control</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Change password<BR ALIGN="LEFT"/>disable link</FONT></TD></TR></TABLE>>];
resume -- publication [label="explicitly confirmed publication"];
publication -- generated [label="represents identified content"];
resume -- uploaded [label="associates supplied artifact"];
