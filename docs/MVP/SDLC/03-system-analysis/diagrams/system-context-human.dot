// OWNER-MVP-2026-11-04 review: MVP core / cross-cutting. Core presentation/application/files or shared authority/recovery invariant remains applicable.
digraph MVP {
 graph [rankdir=TB,bgcolor="white",fontname="Arial",label="Version 1 = MVP — accepted responsibility allocation",labelloc=t];
 node [shape=box,style="rounded,filled",fontname="Arial",fillcolor="#E4F0FC",margin="0.18,0.12"];
 edge [fontname="Arial",fontsize=10];
 core [label="Resumefolio core\nLC-01 Identity: invited accounts\nLC-02 Presentation / LC-03 Sharing\nLC-04 Applications: actual materials + follow-up\nLC-09 Files / Operations: private same-server media"];
 forge [label="ProjectForge — separate system\nLC-07 real Git / permissions / file-history\nLC-06 issues / simple Kanban\nNative Git Smart HTTP / Laravel\nSeparate MySQL 8.4 / same host, separate OS user",fillcolor="#DCF2E5"];
 future [label="AFTER MVP\nLC-05 private communications via API\nAdvanced LC-06 backlog / Sprints\nAdvanced LC-07 review / merge / releases\nLC-08 YAML execution / deployment; AI",fillcolor="#F6EBD9"];
 core -> forge [dir=both,label="authenticated user-scoped API\nno common database / transaction assumed"];
 core -> future [style=dashed,label="later planning; no implementation now"];
}
