// OWNER-MVP-2026-11-04 review: Mixed MVP / future. Retained broader-product associations require explicit future node labels; MVP uses only core/basic ProjectForge.
graph domain {
 graph [label="AFTER MVP advanced model | domain git collaboration",labelloc=t];
graph [rankdir=LR,bgcolor="white",pad="0.35",nodesep="0.5",ranksep="0.9",splines=polyline,fontname="Segoe UI",fontsize=15];node [shape=plain,fontname="Segoe UI"];edge [fontname="Segoe UI",fontsize=10,color="#547083",fontcolor="#344f61",penwidth=1.15];
repo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Git repository</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C32 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Repository identity<BR ALIGN="LEFT"/>owner context<BR ALIGN="LEFT"/>refs</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Create<BR ALIGN="LEFT"/>authorize real Git operations</FONT></TD></TR></TABLE>>];
revision [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Git revision</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C33 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Revision identity<BR ALIGN="LEFT"/>content/history</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Identify<BR ALIGN="LEFT"/>compare<BR ALIGN="LEFT"/>browse</FONT></TD></TR></TABLE>>];
ref [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Git reference</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C34 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Name/kind<BR ALIGN="LEFT"/>target state</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Create/update under ref authority</FONT></TD></TR></TABLE>>];
pr [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Pull request</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C35 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Source/target<BR ALIGN="LEFT"/>evaluation context<BR ALIGN="LEFT"/>state</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Open<BR ALIGN="LEFT"/>discuss<BR ALIGN="LEFT"/>request controlled merge</FONT></TD></TR></TABLE>>];
review [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Review / comment</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C36 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Author<BR ALIGN="LEFT"/>reviewed context<BR ALIGN="LEFT"/>decision/content</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Comment<BR ALIGN="LEFT"/>submit review</FONT></TD></TR></TABLE>>];
issue [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Repository issue</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C37 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Repository context<BR ALIGN="LEFT"/>issue state</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Record<BR ALIGN="LEFT"/>discuss<BR ALIGN="LEFT"/>update</FONT></TD></TR></TABLE>>];
milestone [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Repository milestone</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C38 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Checkpoint<BR ALIGN="LEFT"/>related issue context</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Organize repository planning</FONT></TD></TR></TABLE>>];
release [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Release record</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C39 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Revision/tag context<BR ALIGN="LEFT"/>release assets</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Publish/manage under reviewed policy</FONT></TD></TR></TABLE>>];
repo -- revision [label="hosts content / history"];
repo -- ref [label="names branches / tags"];
ref -- revision [label="identifies target state"];
repo -- pr [label="participates as source / target"];
pr -- review [label="receives discussion / review"];
pr -- revision [label="evaluated source / target context"];
repo -- issue [label="contains repository work"];
issue -- milestone [label="may target checkpoint"];
repo -- release [label="publishes release context"];
release -- revision [label="identifies intended Git state"];
}
