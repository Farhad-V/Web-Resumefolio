@startuml
' OWNER-MVP-2026-11-04 review: MVP core. Manual applications stay in MVP regardless of a historical communication filename.
skinparam backgroundColor white
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #526B7B
skinparam ArrowFontSize 11
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide circle
skinparam classBackgroundColor #EDF4FB
skinparam classBorderColor #526B7B
skinparam classHeaderBackgroundColor #DFF1EF
skinparam noteBackgroundColor #FFF3DF
skinparam noteBorderColor #B99557
skinparam rectangleBackgroundColor #EDF4FB
skinparam rectangleBorderColor #526B7B
skinparam activityBackgroundColor #EDF4FB
skinparam activityBorderColor #526B7B
skinparam activityDiamondBackgroundColor #DFF1EF
skinparam activityDiamondBorderColor #458F88
skinparam padding 6
skinparam nodesep 35
skinparam ranksep 40
hide empty members
title Application preparation and actual submitted history
top to bottom direction
class "Company\nDM-C14" as company {
  Organization context
  supplied details
}
class "Job opportunity\nDM-C15" as opportunity {
  Role context
  source/deadline details
}
class "Application record\nDM-C16" as application {
  Progress
  intended material associations
}
class "Cover letter\nDM-C17" as letter {
  Authored text
  revision context
}
class "Submission record\nDM-C18" as submission {
  Actual event context
  capture completeness
}
class "Preserved submitted\nmaterial\nDM-C19" as material {
  Actual content/artifact
  provenance
}
company -right- opportunity : organization context
opportunity -down- application : intended position
application -left- letter : editable preparation
application -down- submission : recorded submission
submission -right- material : actual captured material
legend bottom
Solid lines: conceptual associations, not process steps.
Relationship bounds: document 03, section 3.
An unlabeled end is unspecified, not implicitly one.
Properties are semantic, not mandatory database fields.
endlegend
note "MVP manual application: status, next action and follow-up date.\nPreserve actual submitted materials; no mail/calendar dependency." as MVPFollowUp
@enduml
