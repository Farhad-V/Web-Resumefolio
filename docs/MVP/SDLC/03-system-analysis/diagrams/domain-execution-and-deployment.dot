// OWNER-MVP-2026-11-04 review: Future after MVP. Provider, advanced Sprint/review, or untrusted execution requirement retained as deferred.
graph domain {
 graph [label="AFTER MVP | domain execution and deployment",labelloc=t];
graph [rankdir=LR,bgcolor="white",pad="0.35",nodesep="0.5",ranksep="0.9",splines=polyline,fontname="Segoe UI",fontsize=15];node [shape=plain,fontname="Segoe UI"];edge [fontname="Segoe UI",fontsize=10,color="#547083",fontcolor="#344f61",penwidth=1.15];
workflow [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Workflow definition</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C40 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Definition identity<BR ALIGN="LEFT"/>trigger/steps</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Validate definition<BR ALIGN="LEFT"/>evaluate eligibility</FONT></TD></TR></TABLE>>];
run [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Workflow run</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C41 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Revision/definition<BR ALIGN="LEFT"/>initiator<BR ALIGN="LEFT"/>result</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Request<BR ALIGN="LEFT"/>reconcile execution outcome</FONT></TD></TR></TABLE>>];
attempt [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Execution attempt</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C42 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Attempt context<BR ALIGN="LEFT"/>state<BR ALIGN="LEFT"/>resource use</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Start<BR ALIGN="LEFT"/>cancel<BR ALIGN="LEFT"/>reconcile<BR ALIGN="LEFT"/>retry explicitly</FONT></TD></TR></TABLE>>];
output [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Run output</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C43 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Producing context<BR ALIGN="LEFT"/>availability<BR ALIGN="LEFT"/>content</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Expose permitted output<BR ALIGN="LEFT"/>clean eligible data</FONT></TD></TR></TABLE>>];
secret [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Scoped secret authority</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C44 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Permitted use context<BR ALIGN="LEFT"/>restriction</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Evaluate use authority<BR ALIGN="LEFT"/>revoke</FONT></TD></TR></TABLE>>];
deployment [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Deployment authorization</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C45 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Target<BR ALIGN="LEFT"/>artifact/revision<BR ALIGN="LEFT"/>approval context</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Approve/reject intended deployment</FONT></TD></TR></TABLE>>];
target [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Deployment target</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C46 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Target identity<BR ALIGN="LEFT"/>operating constraints</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Evaluate authorized deployment outcome</FONT></TD></TR></TABLE>>];
workflow -- run [label="evaluated definition context"];
run -- attempt [label="tracks execution / retry context"];
attempt -- output [label="produces restricted results"];
attempt -- secret [label="requires scoped use authority"];
run -- deployment [label="may supply evaluated result"];
deployment -- target [label="authorizes exact intended effect"];
}
