@startuml
' OWNER-MVP-2026-11-04 review: Future after MVP. Provider, advanced Sprint/review, or untrusted execution requirement retained as deferred.
skinparam backgroundColor white
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #526B7B
skinparam ArrowFontSize 11
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide circle
skinparam classBackgroundColor #EDF4FB
skinparam classBorderColor #526B7B
skinparam classHeaderBackgroundColor #DFF1EF
skinparam noteBackgroundColor #FFF3DF
skinparam noteBorderColor #B99557
skinparam rectangleBackgroundColor #EDF4FB
skinparam rectangleBorderColor #526B7B
skinparam activityBackgroundColor #EDF4FB
skinparam activityBorderColor #526B7B
skinparam activityDiamondBackgroundColor #DFF1EF
skinparam activityDiamondBorderColor #458F88
skinparam padding 6
skinparam nodesep 35
skinparam ranksep 40
hide empty members
title AFTER MVP — Execution provenance and separate deployment authority
top to bottom direction
class "Workflow definition\nDM-C40" as workflow {
  Definition identity
  trigger/steps
}
class "Workflow run\nDM-C41" as run {
  Revision/definition
  initiator
  result
}
class "Execution attempt\nDM-C42" as attempt {
  Attempt context
  state
  resource use
}
class "Run output\nDM-C43" as output {
  Producing context
  availability
  content
}
class "Scoped secret authority\nDM-C44" as secret {
  Permitted use context
  restriction
}
class "Deployment authorization\nDM-C45" as deployment {
  Target
  artifact/revision
  approval context
}
class "Deployment target\nDM-C46" as target {
  Target identity
  operating constraints
}
workflow -- run : effective definition
run -- attempt : execution / retry context
attempt -- output : produced output
attempt -- secret : scoped use authority
run -- deployment : evaluated result context
deployment -- target : separate target authority
legend bottom
Solid lines: conceptual associations, not process steps.
Relationship bounds: document 03, section 3.
An unlabeled end is unspecified, not implicitly one.
Properties are semantic, not mandatory database fields.
endlegend
@enduml
