@startuml
' OWNER-MVP-2026-11-04 review: MVP core / cross-cutting. Core presentation/application/files or shared authority/recovery invariant remains applicable.
skinparam backgroundColor white
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundcorner 5
skinparam classAttributeIconSize 0
hide circle
skinparam classBackgroundColor #EDF4FB
skinparam classBorderColor #526B7B
skinparam classHeaderBackgroundColor #DFF1EF
skinparam ArrowColor #526B7B
skinparam ArrowFontSize 11
skinparam noteBackgroundColor #FFF3DF
skinparam noteBorderColor #B99557
skinparam nodesep 35
skinparam ranksep 42
skinparam padding 6
hide empty members
top to bottom direction

title Data — source information and independent tailoring
entity "Professional profile" as P {
  source identity
  owner context
}
entity "Professional entry" as E {
  entry identity
  source content identity
}
entity "Tailored resume" as R {
  resume identity
  editable content context
}
entity "Source selection" as S {
  resume context
  selected entry identity
}
entity "Independent override" as O {
  resume context
  target field / value
}
P ||--o{ E : P: source entries
P ||--o{ R : P: reusable source context
R ||--o{ S : P: selected source information
E ||--o{ S : P: referenced source entry
R ||--o{ O : P: independent tailoring
legend bottom
Conceptual ER view; not tables or foreign keys.
P = explicit working proposal, not owner acceptance.
A = established scope meaning. Unmarked counts are unspecified.
One / optional / many symbols describe relationship ends.
endlegend
@enduml
