@startuml
' OWNER-MVP-2026-11-04 review: Reference / reusable template. Illustrative contract/model/pattern, not a product release commitment.
allowmixing
title Template example — Algorithm data structures and identities
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0

class ValidatedIntent {
 actorId
 resumeId
 expectedDraftVersion
 commandId
 canonicalIntentBinding
}
class CommandResultIndex {
 scopedCommandIdentity
 boundIntent
 outcomeReference
}
class DraftSnapshot {
 sourceVersion
 selectedContent
}
class CommitBundle {
 revisionIdentity
 immutableSnapshot
 livePointerChange
 attributableResult
}
ValidatedIntent ..> CommandResultIndex : guarded scoped lookup
ValidatedIntent ..> DraftSnapshot : exact expected version
DraftSnapshot --> CommitBundle : validated snapshot
CommitBundle --> CommandResultIndex : coherent result recording

@enduml
