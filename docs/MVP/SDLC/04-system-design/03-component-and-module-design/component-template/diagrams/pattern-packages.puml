@startuml
' OWNER-MVP-2026-11-04 review: Reference / reusable template. Illustrative contract/model/pattern, not a product release commitment.
allowmixing
title Template example — Illustrative package and folder conventions
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0

package "ComponentName (placeholder)" {
 package "Contracts" as C
 package "Application" as A
 package "Domain" as D
 package "Infrastructure" as I
 package "Transport" as T
 T ..> A
 A ..> C
 A ..> D
 I ..> C
 I ..> D : mapping values
}
package "CompositionRoot" as R
R ..> I : bind concrete dependencies
R ..> T

@enduml
