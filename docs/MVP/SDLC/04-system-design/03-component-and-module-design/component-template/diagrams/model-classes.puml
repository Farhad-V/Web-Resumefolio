@startuml
' OWNER-MVP-2026-11-04 review: Reference / reusable template. Illustrative contract/model/pattern, not a product release commitment.
allowmixing
title Template example — Class structure: visibility, types and operations
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0

class ResumeDraft {
 -id : ResumeId
 -version : DraftVersion
 -selection : ConfirmedSelection
 +snapshot(expected : DraftVersion) : DraftSnapshot
 +applySelected(change : ConfirmedSelection, expected : DraftVersion) : ApplyOutcome
}
class DraftSnapshot <<immutable>> {
 +sourceVersion : DraftVersion
 +content : SelectedContent
}
class PublishedResumeRevision <<immutable>> {
 +id : RevisionId
 +sourceDraftVersion : DraftVersion
 +content : SelectedContent
}
class ResumeId <<value object>> {
 -value : ValidatedIdentifier
 +equals(other : ResumeId) : Boolean
}
ResumeDraft --> ResumeId
ResumeDraft ..> DraftSnapshot : creates validated snapshot
PublishedResumeRevision ..> DraftSnapshot : explicit publication input

@enduml
