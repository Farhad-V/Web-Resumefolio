@startuml
' OWNER-MVP-2026-11-04 review: Reference / reusable template. Illustrative contract/model/pattern, not a product release commitment.
allowmixing
title Template example — Realization: contract to implementation
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0

interface PublicationCommand {
 +publish(intent) : PublicationOutcome
}
class PublishRevisionHandler {
 +publish(intent) : PublicationOutcome
}
PublishRevisionHandler ..|> PublicationCommand

@enduml
