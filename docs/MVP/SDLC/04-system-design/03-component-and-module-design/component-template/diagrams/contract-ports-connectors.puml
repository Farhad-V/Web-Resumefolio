@startuml
' OWNER-MVP-2026-11-04 review: Reference / reusable template. Illustrative contract/model/pattern, not a product release commitment.
allowmixing
title Template example — Composite structure: ports and connectors
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0

component "Example Presentation boundary" as C {
 portin "command port" as IN
 portout "authority port" as AUTH
 portout "persistence port" as STORE
 component "handler : PublishRevisionHandler" as H
 component "draft policy : ResumeDraft" as D
 IN --> H : delegate
 H --> D : invariant collaboration
 H --> AUTH : required authority
 H --> STORE : required coherent commit
}
component "Caller" as X
component "Identity contract provider" as A
component "Persistence adapter" as S
X --> IN
AUTH --> A
STORE --> S

@enduml
