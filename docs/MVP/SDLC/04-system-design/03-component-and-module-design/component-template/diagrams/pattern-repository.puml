@startuml
' OWNER-MVP-2026-11-04 review: Reference / reusable template. Illustrative contract/model/pattern, not a product release commitment.
allowmixing
title Template example — Optional Repository-like persistence port
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0

class PublishRevisionHandler <<Client>>
interface PublicationStore <<RepositoryLikePort>> {
 +commitConfirmedRevision(intent, snapshot) : PublicationOutcome
}
class PersistenceAdapter <<ConcreteAdapter>>
class OwnedPersistenceRecords <<Mapping>>
PublishRevisionHandler --> PublicationStore
PersistenceAdapter ..|> PublicationStore
PersistenceAdapter --> OwnedPersistenceRecords

@enduml
