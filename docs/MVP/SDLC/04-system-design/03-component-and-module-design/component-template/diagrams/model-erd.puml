@startuml
' OWNER-MVP-2026-11-04 review: Reference / reusable template. Illustrative contract/model/pattern, not a product release commitment.
allowmixing
title Template example — ERD: selected persisted relationships
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0

entity "Resume" as R {
 * resume_id : identifier <<PK>>
}
entity "Draft" as D {
 * resume_id : identifier <<PK, FK>>
 * version : integer
}
entity "PublicationRevision" as P {
 * revision_id : identifier <<PK>>
 * resume_id : identifier <<FK>>
 * source_draft_version : integer
}
entity "LivePublication" as L {
 * resume_id : identifier <<PK, FK>>
 * revision_id : identifier <<FK>>
}
R ||--|| D : editable state
R ||--o{ P : historical revisions
R ||--o| L : optional live selection
P ||--o| L : selected revision

@enduml
