@startuml
' OWNER-MVP-2026-11-04 review: Reference / reusable template. Illustrative contract/model/pattern, not a product release commitment.
allowmixing
title Template example — Optional interface segregation: before and after
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0

package "Before: overly broad counterexample" {
 interface EverythingAPI {
  +readProjection()
  +publish()
  +administerHost()
 }
 component "Read consumer" as R1
 R1 --> EverythingAPI
}
package "After: required capability only" {
 interface PermittedProjectionReader {
  +read(context, revision) : ProjectionOutcome
 }
 interface PublicationCommand {
  +publish(intent) : PublicationOutcome
 }
 component "Read consumer" as R2
 component "Command consumer" as C
 R2 --> PermittedProjectionReader
 C --> PublicationCommand
}

@enduml
