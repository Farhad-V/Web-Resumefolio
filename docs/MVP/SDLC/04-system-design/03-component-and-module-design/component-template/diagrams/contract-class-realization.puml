@startuml
' OWNER-MVP-2026-11-04 review: Reference / reusable template. Illustrative contract/model/pattern, not a product release commitment.
allowmixing
title Template example — Classes realizing the provided command
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0

interface PublicationCommand {
 +publish(intent : PublishIntent) : PublicationOutcome
}
class PublishRevisionHandler {
 +publish(intent : PublishIntent) : PublicationOutcome
}
class PublishIntent {
 +actorId : ActorId
 +resumeId : ResumeId
 +expectedDraftVersion : RevisionId
 +commandId : CommandId
}
class ResumeDraft {
 +snapshot(expectedVersion) : DraftSnapshot
}
interface ResourceAuthority
interface PublicationStore
PublishRevisionHandler ..|> PublicationCommand
PublishRevisionHandler ..> PublishIntent
PublishRevisionHandler --> ResumeDraft
PublishRevisionHandler --> ResourceAuthority
PublishRevisionHandler --> PublicationStore

@enduml
