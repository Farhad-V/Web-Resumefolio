@startuml
' OWNER-MVP-2026-11-04 review: Reference / reusable template. Illustrative contract/model/pattern, not a product release commitment.
allowmixing
title Template example — Inheritance hierarchy: justified alternative results
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0

abstract class PublicationOutcome {
 +commandId : CommandId
}
class Committed {
 +revisionId : RevisionId
}
class Denied
class Conflict {
 +safeConflictKind : ConflictKind
}
class Unresolved {
 +lookupReference : CommandId
}
PublicationOutcome <|-- Committed
PublicationOutcome <|-- Denied
PublicationOutcome <|-- Conflict
PublicationOutcome <|-- Unresolved

@enduml
