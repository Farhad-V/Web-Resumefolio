@startuml
' OWNER-MVP-2026-11-04 review: Reference / reusable template. Illustrative contract/model/pattern, not a product release commitment.
allowmixing
title Template example — Dependency inversion through the adapter seam
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0

package "High-level owner" {
 class Handler
 interface RequiredPort
 Handler --> RequiredPort
}
package "Infrastructure" {
 class Adapter
 class ConcreteClient
 Adapter ..|> RequiredPort
 Adapter --> ConcreteClient
}

@enduml
