@startuml
' OWNER-MVP-2026-11-04 review: Reference / reusable template. Illustrative contract/model/pattern, not a product release commitment.
allowmixing
title Template example — Factory participants
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0

class PublishRevisionHandler <<Client>>
class RevisionFactory <<SimpleFactory>> {
 +fromConfirmed(snapshot, identity) : PublishedResumeRevision
}
class PublishedResumeRevision <<Product>>
PublishRevisionHandler --> RevisionFactory
RevisionFactory ..> PublishedResumeRevision : constructs valid identity / content

@enduml
