@startuml
' OWNER-MVP-2026-11-04 review: Reference / reusable template. Illustrative contract/model/pattern, not a product release commitment.
title Template illustration — explicit publication algorithm
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam shadowing false
skinparam activityBackgroundColor #EFF6FF
skinparam activityBorderColor #64748B
start
:Validate explicit intent;
:Begin bounded local transaction;
:Obtain chosen command/resource guard;
:Evaluate current authority and lifecycle;
if (Authorized?) then (yes)
 :Resolve command identity and intent;
 if (Different intent for same identity?) then (yes)
  :Finish without publication mutation;
  :Return conflict;
  stop
 else (no)
  if (Recorded same-intent outcome?) then (yes)
   :Finish; return currently permitted result;
   stop
  else (no)
   :Load intended draft/version;
   if (Confirmed expected version matches?) then (yes)
    :Construct identified publication;
    :Persist revision + live pointer + command result;
    :Commit local transaction;
    :Return confirmed publication identity;
    stop
   else (no)
    :Finish without publication mutation;
    :Return conflict;
    stop
   endif
  endif
 endif
else (no)
 :Finish without publication mutation;
 :Return permitted denial;
 stop
endif
@enduml
