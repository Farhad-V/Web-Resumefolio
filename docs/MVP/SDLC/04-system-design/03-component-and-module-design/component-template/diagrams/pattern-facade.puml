@startuml
' OWNER-MVP-2026-11-04 review: Reference / reusable template. Illustrative contract/model/pattern, not a product release commitment.
allowmixing
title Template example — Facade participants
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0

class PublicationController <<Client>>
class PublishRevisionHandler <<Facade>>
class ResumeDraft <<SubsystemRole>>
interface ResourceAuthority <<SubsystemContract>>
interface PublicationStore <<SubsystemContract>>
PublicationController --> PublishRevisionHandler
PublishRevisionHandler --> ResumeDraft
PublishRevisionHandler --> ResourceAuthority
PublishRevisionHandler --> PublicationStore

@enduml
