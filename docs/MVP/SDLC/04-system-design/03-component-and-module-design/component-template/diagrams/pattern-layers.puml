@startuml
' OWNER-MVP-2026-11-04 review: Reference / reusable template. Illustrative contract/model/pattern, not a product release commitment.
allowmixing
title Template example — Allowed versus forbidden dependencies
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0

package "Proposed allowed direction" {
 class Transport
 class Application
 class Domain
 interface RequiredPort
 class InfrastructureAdapter
 Transport --> Application
 Application --> Domain
 Application --> RequiredPort
 InfrastructureAdapter ..|> RequiredPort
}
class OtherOwnerPrivateTables
Application -[#red,dashed]-> OtherOwnerPrivateTables : forbidden cross-owner write
Domain -[#red,dashed]-> Transport : forbidden transport coupling

@enduml
