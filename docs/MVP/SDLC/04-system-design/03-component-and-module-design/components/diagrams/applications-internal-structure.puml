@startuml
' OWNER-MVP-2026-11-04 review: MVP core. Manual applications stay in MVP regardless of a historical communication filename.
allowmixing
title Proposed — Internal responsibility areas within LC-04
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial

component "Applications boundary" {
 component "Private preparation" as P
 component "Manual progress history" as G
 component "Actual event / material capture" as C
 component "Attributable correction" as R
 component "Permitted queries / lifecycle" as Q
 interface "Owned store / version / command identity" as S
 P --> S
 G --> S
 C --> S
 R --> S
 Q --> S
}

note "MVP manual application: status, next action and follow-up date.\nPreserve actual submitted materials; no mail/calendar dependency." as MVPFollowUp
@enduml
