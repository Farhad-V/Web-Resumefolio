@startuml
' OWNER-MVP-2026-11-04 review: Future after MVP. Provider, advanced Sprint/review, or untrusted execution requirement retained as deferred.
title AFTER MVP — Proposed — Owner communication and calendar use cases
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial

left to right direction
actor "Authorized owner" as U
rectangle "LC-05" {
 usecase "Read / compose / save draft" as D
 usecase "Review and deliberately send / reply" as S
 usecase "Save local activity / reminder intent" as L
 usecase "Explicitly publish selected activity" as P
 usecase "Review invitation / attendee capability\nonly if source and adapter permit" as I
 usecase "Reconcile / disconnect selected account" as R
}
U --> D
U --> S
U --> L
U --> P
U --> I
U --> R

@enduml
