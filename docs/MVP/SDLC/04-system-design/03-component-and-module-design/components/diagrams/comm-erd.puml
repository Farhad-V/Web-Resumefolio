}
entity LocalActivity {
 * activity_id : identity
}
entity EventMapping {
 * mapping_id : identity
 provider_calendar_id : scoped reference
 provider_event_id : scoped reference
}
entity AttendeeObservation {
 * observation_id : identity
 response : observed provider state
}
entity ReminderIntent {
 * reminder_id : identity
}
Connection ||--o{ CorrespondenceProjection
Connection ||--o{ EventMapping
LocalActivity ||--o{ EventMapping
EventMapping ||--o{ AttendeeObservation
LocalActivity ||--o{ ReminderIntent

@enduml
