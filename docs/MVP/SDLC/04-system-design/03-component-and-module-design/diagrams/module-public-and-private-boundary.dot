// OWNER-MVP-2026-11-04 review: MVP core / cross-cutting. Core presentation/application/files or shared authority/recovery invariant remains applicable.
digraph G {rankdir=TB;graph [bgcolor="white",pad="0.3",nodesep="0.35",ranksep="0.55",fontname="Arial"];node [shape=box,style="rounded,filled",fillcolor="#eff6ff",color="#64748b",fontname="Arial",fontsize=12,margin="0.17,0.12"];edge [fontname="Arial",fontsize=10,color="#64748b"];
consumer [label="Consumer module
Actor / resource / operation / expected version"];
subgraph cluster_owner {label="Resource-owning module — proposed boundary";style=rounded;color="#93c5fd";
public [label="Exported application contract
Current authority + permitted result",fillcolor="#dbeafe"];
internal [label="Internal handler / invariant policy
Owned mutation and protected state",fillcolor="#dcfce7"];
data [label="Private persistence mapping / state
No consumer-side direct writes"];
public->internal->data;
}
consumer->public [label="allowed contract"];
note [label="Public contract is not public internet access
A stable identifier is not permission",shape=note,fillcolor="#fef3c7"];
consumer->note [style=dashed,arrowhead=none];
}
