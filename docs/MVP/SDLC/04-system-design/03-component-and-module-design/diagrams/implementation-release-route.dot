// OWNER-MVP-2026-11-04 review: MVP core / cross-cutting. Core presentation/application/files or shared authority/recovery invariant remains applicable.
digraph G {rankdir=TB;graph [bgcolor="white",pad="0.3",nodesep="0.35",ranksep="0.55",fontname="Arial"];node [shape=box,style="rounded,filled",fillcolor="#eff6ff",color="#64748b",fontname="Arial",fontsize=12,margin="0.17,0.12"];edge [fontname="Arial",fontsize=10,color="#64748b"];
inputs [label="Identified source / dependencies / toolchain"];
build [label="Resolve and build controlled outputs
Check declared compatibility"];
verify [label="Static / boundary / relevant actual integration checks",fillcolor="#dcfce7"];
assemble [label="Assemble candidate + release manifest
Exclude secrets and operating data",fillcolor="#dbeafe"];
rehearse [label="Isolated deployment / migration rehearsal
Evaluate app-worker-data compatibility"];
promote [label="Actual scoped promotion decision
Observe effective release and retain evidence",fillcolor="#fef3c7"];
inputs->build->verify->assemble->rehearse->promote;
note [label="A documentation render is not a product build
Artifact rollback does not reverse irreversible data / external effects",shape=note,fillcolor="#ffedd5"];promote->note [style=dashed,arrowhead=none];
}
