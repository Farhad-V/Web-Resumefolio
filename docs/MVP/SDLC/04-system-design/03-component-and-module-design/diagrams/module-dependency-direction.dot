// OWNER-MVP-2026-11-04 review: Method / document navigation. Scope-independent process/navigation; provider or runner examples are not MVP prerequisites.
digraph G {rankdir=TB;graph [bgcolor="white",pad="0.3",nodesep="0.35",ranksep="0.55",fontname="Arial"];node [shape=box,style="rounded,filled",fillcolor="#eff6ff",color="#64748b",fontname="Arial",fontsize=12,margin="0.17,0.12"];edge [fontname="Arial",fontsize=10,color="#64748b"];
transport [label="Transport / consuming module"];
contract [label="Owner's public contract
Permitted projections",fillcolor="#dbeafe"];
application [label="Owning application / domain responsibility",fillcolor="#dcfce7"];
port [label="Meaningful required technical port",fillcolor="#fef3c7"];
infra [label="Infrastructure implementation
Provider / Git / storage / executor"];
transport->contract [label="uses"];contract->application [label="realized by"];application->port [label="requires"];infra->port [label="implements",style=dashed];
note [label="Reject cyclic internal dependencies and foreign-state writes
Keep shared primitives small",shape=note,fillcolor="#fee2e2"];application->note [arrowhead=none,style=dashed];
}
