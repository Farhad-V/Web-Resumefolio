// OWNER-MVP-2026-11-04 review: MVP core / cross-cutting. Core presentation/application/files or shared authority/recovery invariant remains applicable.
digraph G {rankdir=TB;graph [bgcolor="white",pad="0.3",nodesep="0.35",ranksep="0.55",fontname="Arial"];node [shape=box,style="rounded,filled",fillcolor="#eff6ff",color="#64748b",fontname="Arial",fontsize=12,margin="0.17,0.12"];edge [fontname="Arial",fontsize=10,color="#64748b"];
root [label="Framework composition root
Wire approved contracts / implementations",fillcolor="#dbeafe"];
scope [label="Fresh command or job context
Current actor / authority / version / claim",fillcolor="#dcfce7"];
handler [label="Explicit use-case handler
Bounded transaction and resources"];
adapters [label="Injected clock / persistence / effect adapters
Scope and result contracts remain explicit",fillcolor="#fef3c7"];
finish [label="Complete / fail / reconcile
Release transaction, private state and resources"];
root->handler [label="constructs"];scope->handler [label="operation-scoped context"];handler->adapters;handler->finish;
note [label="No shared singleton retains a user/session/transaction
Long-lived workers establish fresh context per job",shape=note,fillcolor="#ffedd5"];finish->note [style=dashed,arrowhead=none];
}
