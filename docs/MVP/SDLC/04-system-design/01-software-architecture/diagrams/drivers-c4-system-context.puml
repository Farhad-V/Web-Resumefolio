skinparam shadowing false
skinparam defaultFontName Arial
skinparam wrapWidth 180
actor "Private user\nCreated/invited by owner/admin" as U
actor "Employer viewer" as E
actor "Native Git client user" as G
rectangle "Resumefolio core\nDashboard / profile / resumes / portfolio\nPDF/sharing / manual applications\nPrivate same-server My Files & Media" as C #E4F0FC
