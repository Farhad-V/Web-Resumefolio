// OWNER-MVP-2026-11-04 review: Mixed MVP / future. Retained broader-product associations require explicit future node labels; MVP uses only core/basic ProjectForge.
digraph G {
 graph [label="MVP + EXPLICIT FUTURE PATHS | component contract boundaries",labelloc=t];rankdir=TB;graph [bgcolor="white",pad="0.3",nodesep="0.35",ranksep="0.55",fontname="Arial"]; node [shape=box,style="rounded,filled",fillcolor="#eff6ff",color="#64748b",fontname="Arial",fontsize=12,margin="0.18,0.12"]; edge [fontname="Arial",fontsize=10,color="#64748b"];
caller [label="Consuming component
Stable identifiers + intended operation"];
api [label="Owner's public application contract
Current authority + expected revision",fillcolor="#dbeafe"];
domain [label="Owned policy and domain state
Bounded local mutation",fillcolor="#dcfce7"];
storage [label="Owned persistence adapter"];
intent [label="Durable pending intent
Attributable attempt",fillcolor="#fef3c7"];
adapter [label="Provider / Git / executor adapter
Scoped external operation",fillcolor="#ffedd5"];
caller->api [label="command / permitted query"];api->domain;domain->storage;domain->intent [label="when needed"];intent->adapter [label="dispatch + reconcile"];
denied [label="No direct writes to another owner's
tables, paths or mutable internal models",shape=note,fillcolor="#fee2e2"];
caller->denied [style=dashed,arrowhead=none];
}
