// OWNER-MVP-2026-11-04 review: MVP core / cross-cutting. Core presentation/application/files or shared authority/recovery invariant remains applicable.
digraph G {rankdir=TB;graph [bgcolor="white",pad="0.3",nodesep="0.35",ranksep="0.55",fontname="Arial"];node [shape=box,style="rounded,filled",fillcolor="#eff6ff",color="#64748b",fontname="Arial",fontsize=12,margin="0.17,0.12"];edge [fontname="Arial",fontsize=10,color="#64748b"];
change [label="Identify exact rule / proposed change
Preserve authority and source revision"];
impact [label="Identify shared owner + affected consumers
Data / contracts / runtime / UI / operating artifacts"];
options [label="Assess alternatives and consequences
Record significant choices in ADRs",fillcolor="#fef3c7"];
update [label="Update owning record once
Update affected component realizations",fillcolor="#dbeafe"];
check [label="Review cross-view agreement
Specify focused effect / protected-state checks"];
decision [label="Record actual candidate and evidence
Scoped disposition; unresolved dependent gates",fillcolor="#dcfce7"];
change->impact->options->update->check->decision;
note [label="No duplicate policy in this overview
No diagram / link check equals product acceptance",shape=note,fillcolor="#f8fafc"];decision->note [style=dashed,arrowhead=none];
}
