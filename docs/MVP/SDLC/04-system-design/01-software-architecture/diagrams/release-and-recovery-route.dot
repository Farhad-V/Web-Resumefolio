// OWNER-MVP-2026-11-04 review: MVP core / cross-cutting. Core presentation/application/files or shared authority/recovery invariant remains applicable.
digraph G {rankdir=TB;graph [bgcolor="white",pad="0.3",nodesep="0.4",ranksep="0.6",fontname="Arial"];node [shape=box,style="rounded,filled",fillcolor="#eff6ff",color="#64748b",fontname="Arial",fontsize=12,margin="0.18,0.12"];edge [fontname="Arial",fontsize=10,color="#64748b"];
candidate [label="Identify release + dependencies
Configuration / migration / operating prerequisites"];
rehearse [label="Isolated rehearsal + recovery compatibility
Control in-flight work and external effects"];
apply [label="Apply evaluated release procedure
Record actual changes"];
verify [shape=diamond,label="Effective readiness and
scoped checks pass?",fillcolor="#fef3c7"];
promote [label="Record actual promotion
Observe workload / worker / storage health",fillcolor="#dcfce7"];
hold [label="Stop promotion; preserve evidence
Classify app / schema / data / external effects",fillcolor="#ffedd5"];
repair [label="Compatible rollback OR reviewed forward repair
Scoped recovery + external reconciliation"];
candidate->rehearse->apply->verify;verify->promote [label="yes"];verify->hold [label="no"];hold->repair;repair->rehearse [label="re-evaluate candidate"];
}
