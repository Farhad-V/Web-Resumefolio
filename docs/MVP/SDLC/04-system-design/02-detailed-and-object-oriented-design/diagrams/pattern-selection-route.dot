// OWNER-MVP-2026-11-04 review: Reference / design method. Native Git/OO/data notation illustration, not a commitment to advanced product features.
digraph G {rankdir=TB;graph [bgcolor="white",pad="0.3",nodesep="0.35",ranksep="0.55",fontname="Arial"];node [shape=box,style="rounded,filled",fillcolor="#eff6ff",color="#64748b",fontname="Arial",fontsize=12,margin="0.17,0.12"];edge [fontname="Arial",fontsize=10,color="#64748b"];
problem [label="Identify concrete invariant / variability / effect boundary"];
simple [label="Consider the simplest correct implementation"];
need [shape=diamond,label="Does a pattern improve
clarity or substitution?"];
plain [label="Keep explicit simple design
Avoid speculative abstraction",fillcolor="#dcfce7"];
pattern [label="Record participants, contracts and collaboration
Compare alternatives and consequences",fillcolor="#fef3c7"];
review [label="Verify source behavior, ownership and failure semantics
Keep component prescriptions together",fillcolor="#dbeafe"];
problem->simple->need;need->plain [label="no"];need->pattern [label="yes"];plain->review;pattern->review;
}
