@startuml
' OWNER-MVP-2026-11-04 review: Reference / design method. Native Git/OO/data notation illustration, not a commitment to advanced product features.
allowmixing
title Proposed — Dependency inversion at the persistence boundary
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
skinparam maxMessageSize 65

package "High-level application" {
 class "PublishRevisionHandler" as H
 interface "PublicationStore" as P {
  +commitConfirmedRevision(intent, snapshot) : PublicationOutcome
 }
 H --> P : depends on contract
}
package "Low-level infrastructure" {
 class "PersistenceAdapter" as A
 database "Local database" as DB
 A --> DB : concrete transaction mechanism
}
A ..|> P : implements

@enduml
