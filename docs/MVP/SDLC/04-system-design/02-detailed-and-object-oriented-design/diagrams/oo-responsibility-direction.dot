// OWNER-MVP-2026-11-04 review: Reference / design method. Native Git/OO/data notation illustration, not a commitment to advanced product features.
digraph G {rankdir=TB;graph [bgcolor="white",pad="0.3",nodesep="0.35",ranksep="0.55",fontname="Arial"];node [shape=box,style="rounded,filled",fillcolor="#eff6ff",color="#64748b",fontname="Arial",fontsize=12,margin="0.17,0.12"];edge [fontname="Arial",fontsize=10,color="#64748b"];
controller [label="Transport / controller
Parse intent; map permitted result"];
handler [label="Application handler
Authorize; version check; bounded orchestration",fillcolor="#dbeafe"];
domain [label="Domain objects / policies
Owned invariants and valid transitions",fillcolor="#dcfce7"];
port [label="Meaningful effect / persistence port
Explicit capability and outcome contract",fillcolor="#fef3c7"];
adapter [label="Infrastructure adapter
Actual database / provider / Git / executor behavior",fillcolor="#ffedd5"];
controller->handler;handler->domain;handler->port;adapter->port [label="implements",style=dashed];
}
