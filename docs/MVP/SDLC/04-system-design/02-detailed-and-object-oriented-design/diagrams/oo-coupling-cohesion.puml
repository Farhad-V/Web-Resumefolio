@startuml
' OWNER-MVP-2026-11-04 review: Reference / design method. Native Git/OO/data notation illustration, not a commitment to advanced product features.
allowmixing
title Proposed — Coupling and cohesion: compare responsibility shapes
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
skinparam maxMessageSize 65

package "Low cohesion / broad coupling: counterexample" {
 class "EverythingService" as E
 class MailSDK
 class ResumeTables
 class GitProcess
 E --> MailSDK
 E --> ResumeTables
 E --> GitProcess
}
package "Cohesive selected use case" {
 class "PublishRevisionHandler" as H
 class "ResumeDraft" as D
 interface "ResourceAuthority" as A
 interface "PublicationStore" as S
 H --> D : publication invariant
 H --> A : current scope
 H --> S : guarded commit
}

@enduml
