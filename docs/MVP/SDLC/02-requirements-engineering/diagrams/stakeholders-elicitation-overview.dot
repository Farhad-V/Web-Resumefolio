// OWNER-MVP-2026-11-04 review: Method / document navigation. Scope-independent process/navigation; provider or runner examples are not MVP prerequisites.
digraph StakeholdersElicitation {
 graph [rankdir=TB,bgcolor="white",pad=0.35,ranksep=0.5,nodesep=0.4,fontname="Arial",fontsize=20,labelloc=t,
 label="Resumefolio | Stakeholders and elicitation\nActor context, planned work and actual evidence have separate roles"];
 node [shape=box,style="rounded,filled",fontname="Arial",fontsize=13,color="#64748B",fontcolor="#17324D",margin="0.22,0.16",fillcolor="#DBEAFE"];
 edge [color="#64748B",arrowsize=0.7,fontname="Arial",fontsize=11];
 sources [label="ACCEPTED PLANNING / SOURCE MATERIAL\nScope, objectives and exact source context",fillcolor="#17324D",fontcolor=white];
 actors [label="ACTORS AND SYSTEM CONTEXT\nGoals, interactions, resource contexts\nExternal dependencies and open boundaries"];
 plan [label="ELICITATION PLAN AND TECHNIQUES\nGenuine gaps, methods and preparation\nProposed activities - not performed sessions",fillcolor="#EDE9FE"];
 log [label="ELICITATION LOG\nActual activity + date + inspected material / participants\nRaw evidence, separate interpretation and review state",fillcolor="#FEF3C7"];
 actual [label="EXISTING DOCUMENTARY EVIDENCE\nLOG-001 / EXT-001 through EXT-003\nParaphrases checked; interpretations pending review",fillcolor="#FFFBEB"];
 handoff [label="ANALYSIS / SPECIFICATION HANDOFF\nReviewed needs + explicit unresolved questions\nScenarios, definitions and traceability\nNo automatic requirement acceptance",fillcolor="#DCFCE7"];
 sources -> actors;
 actors -> plan [label="identify gaps"];
 sources -> log [label="exact provenance"];
 plan -> log [label="after actual activity"];
 log -> actual [label="recorded evidence"];
 log -> handoff [label="handoff with explicit gaps"];
 {rank=same;actors;log;}
 {rank=same;plan;actual;}
}
