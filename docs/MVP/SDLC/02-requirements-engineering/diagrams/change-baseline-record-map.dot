// OWNER-MVP-2026-11-04 review: Method / document navigation. Scope-independent process/navigation; provider or runner examples are not MVP prerequisites.
digraph model {
graph [rankdir=TB,bgcolor="white",pad=0.3,nodesep=0.45,ranksep=0.65,fontname="Arial",fontsize=20,labelloc=t];
node [shape=box,style="rounded,filled",fillcolor="#DBEAFE",color="#64748B",fontcolor="#17324D",fontname="Arial",fontsize=13,margin="0.18,0.14"];
edge [color="#64748B",fontname="Arial",fontsize=11,fontcolor="#17324D"];
graph [label="Resumefolio | Distinct change and baseline records"];
source [label="Accepted planning intent / history
Original DEC / PC / GAP authority"];
question [label="Q-D: unresolved answer / evidence
28 open topics + owner / action / gate",fillcolor="#FEF3C7"];
change [label="CHG-D: actual request / difference
Source + reason + impact / options"];
finding [label="RV / RF: actual bounded observation
Evidence + disposition / recheck"];
decision [label="Actual owner product / change disposition
Proposal + revision + rationale / conditions",fillcolor="#EDE9FE"];
criteria [label="RBC-D01-D12: proposed criteria
Assess an identified coherent candidate"];
baseline [label="Actual requirements baseline outcome
M-02 pending
Separate from later product / release proof",fillcolor="#DCFCE7"];
source -> question; source -> change; source -> criteria;
question -> decision [label="answer if actually decided"];
change -> decision [label="within required authority"];
finding -> decision [label="actual response / recheck"];
decision -> baseline [label="reconciled candidate"];
criteria -> baseline [label="actual assessment needed"];
}
