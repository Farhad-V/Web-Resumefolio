// OWNER-MVP-2026-11-04 review: Method / document navigation. Scope-independent process/navigation; provider or runner examples are not MVP prerequisites.
digraph ProcessOverview {
 graph [rankdir=TB,bgcolor="white",pad=0.35,ranksep=0.45,nodesep=0.4,fontname="Arial",fontsize=20,labelloc=t,
 label="Resumefolio | Requirements process and approach\nIterative work with feasibility input and management throughout"];
 node [shape=box,style="rounded,filled",fontname="Arial",fontsize=13,color="#64748B",fontcolor="#17324D",margin="0.22,0.16",fillcolor="#DBEAFE"];
 edge [color="#64748B",arrowsize=0.7,fontname="Arial",fontsize=11];
 approach [label="01 | APPROACH\nMethod, rationale and review gates",fillcolor="#17324D",fontcolor=white];
 feasibility [label="02 | FEASIBILITY\nInvestigate decisive constraints early\nReassess when conditions change",fillcolor="#FEF3C7"];
 elicit [label="03 | ELICITATION\nSources, actor goals and context"];
 analyze [label="04 | ANALYSIS AND NEGOTIATION\nClarify, classify and resolve trade-offs"];
 specify [label="05 | SPECIFICATION\nPrecise records, criteria and supporting views"];
 review [label="06 | VERIFICATION AND VALIDATION\nSpecification quality and intended use\nFindings can restart earlier activities",fillcolor="#FEF3C7"];
 manage [label="07 | MANAGEMENT THROUGHOUT\nIdentity, states and traceability\nChange, revisions and actual decisions",fillcolor="#EDE9FE"];
 approach -> elicit;
 approach -> feasibility;
 elicit -> analyze -> specify -> review;
 feasibility -> analyze [style=dashed,label="relevant evidence"];
 manage:w -> elicit:e [style=dashed,constraint=false];
 manage:w -> specify:e [style=dashed,constraint=false];
 manage:s -> review:e [style=dashed,constraint=false];
 {rank=same;approach;feasibility;}
 {rank=same;analyze;manage;}
}
