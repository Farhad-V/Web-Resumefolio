// OWNER-MVP-2026-11-04 review: Method / document navigation. Scope-independent process/navigation; provider or runner examples are not MVP prerequisites.
digraph RequirementsAnalysis {
 graph [rankdir=TB,bgcolor="white",pad=0.35,ranksep=0.45,nodesep=0.35,fontname="Arial",fontsize=20,labelloc=t,
 label="Resumefolio | Requirements analysis\nRefine sourced needs - preserve scope and decision history"];
 node [shape=box,style="rounded,filled",fontname="Arial",fontsize=13,color="#64748B",fontcolor="#17324D",margin="0.22,0.16",fillcolor="#DBEAFE"];
 edge [color="#64748B",arrowsize=0.7,fontname="Arial",fontsize=11];
 input [label="SOURCED NEEDS + ACCEPTED PLANNING\nActor goals, context and current decisions",fillcolor="#17324D",fontcolor=white];
 clarify [label="CLARIFY AND DECOMPOSE\nTerms, conditions and individual obligations"];
 classify [label="CLASSIFY AND COMPARE\nRequirement levels / aspects\nDuplicates, gaps and context-specific conflicts"];
 relate [label="CHECK BEHAVIOR AND RELATIONSHIPS\nPermissions, failures, states and data lifecycle\nCross-module effects and dependencies"];
 assess [label="ASSESS AND PROPOSE\nFeasibility evidence, criteria and verification\nPriority / sequence with rationale"];
 issue [label="QUESTIONS AND TRADE-OFFS\nMissing evidence or incompatible needs\nOptions, impacts and actual owner decisions",fillcolor="#FEF3C7"];
 output [label="CONSISTENT CANDIDATE HANDOFF\nSpecification + scenarios + traceability\nUnresolved blockers remain explicit",fillcolor="#DCFCE7"];
 input -> clarify -> classify -> relate -> assess -> output;
 classify -> issue [style=dashed,label="conflict / gap"];
 assess -> issue [style=dashed,label="evidence / trade-off"];
 issue -> clarify [style=dashed,label="clarify or revise",constraint=false];
 {rank=same;relate;issue;}
}
