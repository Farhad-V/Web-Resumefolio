// OWNER-MVP-2026-11-04 review: Method / document navigation. Scope-independent process/navigation; provider or runner examples are not MVP prerequisites.
digraph model {
graph [bgcolor="white",pad=0.3,nodesep=0.45,ranksep=0.75,fontname="Arial",fontsize=20,labelloc=t];
node [shape=box,style="rounded,filled",fillcolor="#DBEAFE",color="#64748B",fontcolor="#17324D",fontname="Arial",fontsize=13,margin="0.18,0.14"];
edge [color="#64748B",fontname="Arial",fontsize=11,fontcolor="#17324D"];
graph [rankdir=LR,label="Resumefolio | Manual application and history boundaries"];
opp [label="Company / opportunity
User-directed application context"];
source [label="Editable preparation
Relevant resume + manual cover letter"];
record [label="User records actual submission
Identify what was actually sent",fillcolor="#EDE9FE"];
history [label="Preserved actual submitted materials
Not overwritten by later source edits",fillcolor="#DCFCE7"];
progress [label="Application progress
Final transitions / corrections pending"];
live [label="Current live shared view
Not proof of historical submitted content",fillcolor="#FEF3C7"];
comm [label="Related correspondence / activities
Independent private access rules"];
opp -> source [label="prepare"];
source -> record [label="actual material may differ"];
record -> history [label="defined capture / completeness"];
record -> progress [label="explicit status coupling"];
source -> live [label="defined current revision"];
opp -> comm [style=dashed,label="agreed relationship"];
}
