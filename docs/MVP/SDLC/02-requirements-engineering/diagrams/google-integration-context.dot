// OWNER-MVP-2026-11-04 review: Future communications. Make communications independent from core and record per-user/multiple-account consent and no admin mail-reading authority.
digraph Aligned {
 graph [rankdir=TB,bgcolor="white",fontname="Arial",label="AFTER MVP | Independent private communications via API",labelloc=t,pad=0.3];
 node [shape=box,style="rounded,filled",fillcolor="#E5F0FB",fontname="Arial",margin="0.18,0.12"];
 edge [fontname="Arial",fontsize=10];
core [label="Resumefolio core"];
 comm [label="Separate private communications system\nPer-user / account / operation authority",fillcolor="#F8EBD7"];
 google [label="Personal Gmail / Google Calendar accounts\nMultiple accounts possible; explicit consent"];
 core -> comm [dir=both,label="authenticated user-scoped API"];
 comm -> google [label="selected-account provider capability"];
 note [label="Owner/admin cannot read users' mail\nOther providers unresolved; no MVP dependency",shape=note];
 comm -> note [style=dashed];
}
