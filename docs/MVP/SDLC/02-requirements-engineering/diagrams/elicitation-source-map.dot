// OWNER-MVP-2026-11-04 review: Method / document navigation. Scope-independent process/navigation; provider or runner examples are not MVP prerequisites.
digraph ElicitationSources {
 graph [rankdir=TB,bgcolor="white",pad=0.35,ranksep=0.45,nodesep=0.35,
 fontname="Arial",fontsize=20,labelloc=t,label="Resumefolio | From sources to reviewed needs\nInformation provenance - not automatic requirement acceptance"];
 node [shape=box,style="rounded,filled",fontname="Arial",fontsize=13,color="#64748B",fontcolor="#17324D",margin="0.22,0.16",fillcolor="#DBEAFE"];
 edge [color="#64748B",arrowsize=0.7,fontname="Arial",fontsize=11];
 planning [label="ACCEPTED PLANNING\nObjectives, Scope and DEC records\nReuse existing decisions"];
 discussion [label="DISCUSSIONS AND WALKTHROUGHS\nActual participants, context and feedback\nSeparate raw need from interpretation"];
 references [label="DOCUMENTS AND OBSERVATIONS\nExact source, version and date\nRecord applicability and limitations"];
 log [label="SOURCE REGISTER AND ELICITATION LOG\nRaw need / observation + provenance\nMethod, rationale and actual activity details",fillcolor="#17324D",fontcolor=white];
 review [label="CLARIFY AND REVIEW\nActor goal, behavior, failures and data rules\nDistinguish interpretation from decision",fillcolor="#FEF3C7"];
 questions [label="OPEN QUESTIONS / CONFLICTS\nMissing evidence or perspectives\nOwner, next action and dependent gate",fillcolor="#FFFBEB"];
 handoff [label="REVIEWED HANDOFF\nAnalysis and candidate specification\nLink scenarios, requirements and traceability",fillcolor="#DCFCE7"];
 planning -> log;discussion -> log;references -> log;
 log -> review;review -> handoff;
 review -> questions [label="if unresolved",style=dashed];
 questions -> review [label="clarification",style=dashed,constraint=false];
 {rank=same;planning;discussion;references;}
 {rank=same;review;questions;}
}
