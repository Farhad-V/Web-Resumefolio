// OWNER-MVP-2026-11-04 review: MVP core / cross-cutting. Core presentation/application/files or shared authority/recovery invariant remains applicable.
digraph AccountContexts {
 graph [rankdir=TB,bgcolor="white",pad=0.35,ranksep=0.5,nodesep=0.4,fontname="Arial",fontsize=20,labelloc=t,
 label="Resumefolio | Identity and access contexts\nConceptual boundaries - exact authentication and role policies remain proposed"];
 node [shape=box,style="rounded,filled",fontname="Arial",fontsize=13,color="#64748B",fontcolor="#17324D",margin="0.22,0.16",fillcolor="#DBEAFE"];
 edge [color="#64748B",arrowsize=0.7,fontname="Arial",fontsize=11];
 account [label="OWNER/ADMIN CREATED OR INVITED ACCOUNT\nValid authentication context\nUnified sign-in to authorized sections",fillcolor="#17324D",fontcolor=white];
 private [label="OWN / AUTHORIZED PRIVATE RESOURCES\nProfiles, resumes, applications, private files/media\nResource/action checks still apply"];
 member [label="COLLABORATION CONTEXT\nSpecific project / board / repository\nOnly defined granted actions",fillcolor="#EDE9FE"];
 admin [label="ADMINISTRATIVE CONTEXT\nExplicit role/resource/action powers\nNo implied private-data authority",fillcolor="#FEF3C7"];
 employer [label="EMPLOYER VIEWER\nNo registered account required\nEligible link + correct password",fillcolor="#DCFCE7"];
 shared [label="SELECTED SHARED CONTENT\nIntended resume / evidence\nOnly permitted files and PDF downloads",fillcolor="#DCFCE7"];
 guard [label="BOUNDARY FOR EACH PROTECTED REQUEST\nIdentity / grant / resource / action / current state\nNo UI-only checks or universal authority",fillcolor="#F1F5F9"];
 account -> private [label="authorized private work"];
 account -> member [label="only if granted"];
 account -> admin [label="only if explicitly granted"];
 employer -> shared [label="limited sharing authorization"];
 private -> guard;member -> guard;admin -> guard;shared -> guard;
 {rank=same;account;employer;}
 {rank=same;private;member;admin;shared;}
}
