// OWNER-MVP-2026-11-04 review: Mixed MVP / future. Retained broader-product associations require explicit future node labels; MVP uses only core/basic ProjectForge.
digraph model {
 graph [label="MVP + EXPLICIT FUTURE PATHS | git hosting capability map",labelloc=t];
graph [bgcolor="white",pad=0.3,nodesep=0.45,ranksep=0.75,fontname="Arial",fontsize=20,labelloc=t];
node [shape=box,style="rounded,filled",fillcolor="#DBEAFE",color="#64748B",fontcolor="#17324D",fontname="Arial",fontsize=13,margin="0.18,0.14"];
edge [color="#64748B",fontname="Arial",fontsize=11,fontcolor="#17324D"];
graph [rankdir=LR,label="Resumefolio | Real Git and collaboration boundaries"];
repo [label="Real hosted repository
Objects / refs / history"];
client [label="Authorized real Git client
Clone / Fetch / Pull / Push"];
browser [label="Authorized browser
Branches / files / history"];
review [label="Fork / Pull Request
Comments / review / Merge",fillcolor="#EDE9FE"];
track [label="Repository tracking
Issues / Milestones / Tags / Releases"];
run [label="Separate conditional workflow execution
Isolation / grants / secrets / limits",fillcolor="#FEF3C7"];
deploy [label="Separate deployment authority
Push or merge is not approval",fillcolor="#FEF3C7"];
recover [label="Explicit lifecycle and recovery
Repository + related metadata + access",fillcolor="#DCFCE7"];
client -> repo [label="selected transport contract",dir=both];
browser -> repo [label="revision-specific access"];
repo -> review [label="defined source / target"];
repo -> track [label="repository context"];
repo -> run [style=dashed,label="explicit trigger policy only"];
run -> deploy [label="required authority / approval"];
track -> recover [style=dashed]; review -> recover [style=dashed];
}
