// OWNER-MVP-2026-11-04 review: Method / document navigation. Scope-independent process/navigation; provider or runner examples are not MVP prerequisites.
digraph ElicitationLog {
 graph [rankdir=TB,bgcolor="white",pad=0.35,ranksep=0.45,nodesep=0.4,fontname="Arial",fontsize=20,labelloc=t,
 label="Resumefolio | Elicitation record provenance\nSource acceptance is distinct from interpretation and requirement acceptance"];
 node [shape=box,style="rounded,filled",fontname="Arial",fontsize=13,color="#64748B",fontcolor="#17324D",margin="0.22,0.16",fillcolor="#DBEAFE"];
 edge [color="#64748B",arrowsize=0.7,fontname="Arial",fontsize=11];
 source [label="SOURCE REGISTER\nSRC reference + exact section / version\nOriginal authority and limits",fillcolor="#17324D",fontcolor=white];
 activity [label="ACTUAL ACTIVITY\nLOG reference + actual date + method\nRecorder / participants or inspected material"];
 extract [label="SOURCE EXTRACT\nEXT reference + context\nLabeled paraphrase / quotation / observation"];
 interpretation [label="SEPARATE INTERPRETATION\nMeaning, assumptions and candidate needs\nActual review state",fillcolor="#FEF3C7"];
 questions [label="OPEN DETAIL / CONFLICT\nSource links + owner + next action\nDependent review gate",fillcolor="#FFFBEB"];
 handoff [label="REVIEWED HANDOFF\nAnalysis / specification / scenarios\nLink real records as allocated",fillcolor="#DCFCE7"];
 source -> activity -> extract -> interpretation;
 interpretation -> questions [label="if unresolved",style=dashed];
 interpretation -> handoff [label="actual feedback and reviewed scope"];
 questions -> handoff [style=dashed,label="unresolved gaps remain explicit"];
 {rank=same;interpretation;questions;}
}
