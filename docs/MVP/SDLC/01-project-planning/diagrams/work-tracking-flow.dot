// OWNER-MVP-2026-11-04 review: MVP ProjectForge. Basic Git/issue/board behavior belongs to separate ProjectForge, with independent user/resource authority.
digraph WorkTracking {
  graph [rankdir=TB, bgcolor="white", pad=0.35, ranksep=0.45, nodesep=0.4,
    fontname="Arial", fontsize=19, labelloc=t,
    label="Resumefolio | Main work-tracking path\nIllustrative workflow - no live board configuration change"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=12,
    color="#CBD5E1", margin="0.2,0.15", fillcolor="#DBEAFE"];
  edge [color="#64748B", arrowsize=0.65, fontname="Arial", fontsize=10];
  backlog [label="BACKLOG\nIdentified work awaiting selection"];
  todo [label="TO DO\nSelected, not started"];
  progress [label="IN PROGRESS\nPerform the scoped work"];
  review [label="IN REVIEW\nAssess conditions, actual results and limitations", fillcolor="#EDE9FE"];
  done [label="DONE\nAgreed conditions satisfied and evidence retained", fillcolor="#DCFCE7"];
  blocked [label="STOPPED / BLOCKED WORK\nRecord reason, next action and responsible person\nDo not imply progress or successful completion", fillcolor="#FEF3C7"];
  backlog -> todo;
  todo -> progress [label="inspect prerequisites first"];
  progress -> review;
  review -> done [label="completion evidenced"];
  review -> progress [label="further work required", style=dashed];
  progress -> blocked [style=dashed, label="if unable to proceed"];
  blocked -> progress [style=dashed, label="after blocker addressed"];
  {rank=same; progress; blocked;}
}
