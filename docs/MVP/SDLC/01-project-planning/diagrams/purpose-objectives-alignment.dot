// OWNER-MVP-2026-11-04 review: MVP core / cross-cutting. Core presentation/application/files or shared authority/recovery invariant remains applicable.
digraph PurposeObjectives {
  graph [rankdir=LR, bgcolor="white", pad=0.35, nodesep=0.32, ranksep=0.55,
    fontname="Arial", fontsize=19, labelloc=t,
    label="Resumefolio | Purpose to outcomes\nPlanning alignment - not implementation status"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=12,
    color="#CBD5E1", penwidth=1.1, margin="0.18,0.14"];
  edge [color="#64748B", arrowsize=0.65];
  p1 [label="Repeated entry and\ninconsistent versions", fillcolor="#F1F5F9"];
  p2 [label="Private content shared\nwithout clear boundaries", fillcolor="#F1F5F9"];
  p3 [label="Unclear submission history\nand missed follow-up", fillcolor="#F1F5F9"];
  p4 [label="Disconnected tools\nand repeated sign-in", fillcolor="#F1F5F9"];
  p5 [label="A working build alone\ndoes not prove readiness", fillcolor="#F1F5F9"];
  g1 [label="OBJ-01 | Reusable information\nIndependently tailored resumes", fillcolor="#DBEAFE"];
  g2 [label="OBJ-02 | Controlled sharing\nProtect pages, files and PDFs", fillcolor="#DBEAFE"];
  g3 [label="OBJ-03 | Manual job applications\nPreserve submitted materials", fillcolor="#DBEAFE"];
  g4 [label="OBJ-04 | Unified environment\nKeep permissions explicit", fillcolor="#DBEAFE"];
  g5 [label="OBJ-05 | Real deployment\nVerify operation and recovery", fillcolor="#DBEAFE"];
  o1 [label="Relevant resumes without\nunintended cross-resume changes", fillcolor="#DCFCE7"];
  o2 [label="Employers see only\nauthorized shared content", fillcolor="#DCFCE7"];
  o3 [label="A traceable record of\nwhat was sent and its progress", fillcolor="#DCFCE7"];
  o4 [label="Connected workflows without\nunrelated private access", fillcolor="#DCFCE7"];
  o5 [label="Evidence-based readiness\nInitial target: 10 users", fillcolor="#DCFCE7"];
  p1 -> g1 -> o1; p2 -> g2 -> o2; p3 -> g3 -> o3;
  p4 -> g4 -> o4; p5 -> g5 -> o5;
  {rank=same; p1 -> p2 -> p3 -> p4 -> p5 [style=invis];}
  {rank=same; g1; g2; g3; g4; g5;}
  {rank=same; o1; o2; o3; o4; o5;}
}
