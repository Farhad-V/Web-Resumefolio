// OWNER-MVP-2026-11-04 review: MVP delivery. Remove Google and CI/CD from MVP prerequisites; preserve M-08 as deferred and add actual follow-up fields.
digraph Aligned {
 graph [rankdir=TB,bgcolor="white",fontname="Arial",label="Version 1 = MVP | Outcome prerequisites; no delivery dates",labelloc=t,pad=0.3];
 node [shape=box,style="rounded,filled",fillcolor="#E5F0FB",fontname="Arial",margin="0.18,0.12"];
 edge [fontname="Arial",fontsize=10];
p [label="M-01 planning + November 4 owner scope\nHistorical DEC-116 acceptance remains identified"];
 r [label="M-02 MVP requirements\nCore + basic ProjectForge; explicit future allocation"];
 d [label="M-03 MVP analysis/design\nUser-scoped API / Git / private media / recovery"];
 f [label="M-04 identity and dashboard\nOwner/admin-created or invited users"];
 c [label="M-05 presentation and private library\nSame-server files/media; PDFs; protected sharing"];
 a [label="M-06 manual applications\nActual submitted material / status\nNext action / follow-up date"];
 g [label="M-07 separate ProjectForge\nReal transfers / permissions / file-history\nIssues / simple Kanban / authenticated API"];
 v [label="M-09 integrated MVP candidate\nSecurity / audit / capacity / demonstrated recovery",fillcolor="#DCF2E5"];
 z [label="M-10 release decision and operating readiness\nNo deployment or deadline established by this diagram"];
 future [label="AFTER MVP — separate planning\nPrivate Gmail/Calendar communications\nAdvanced review/merge/releases / backlog/Sprints\nM-08 YAML execution/deployment / AI",fillcolor="#F8EBD7"];
 p -> r -> d -> f; f -> c -> a; f -> g; a -> v; g -> v; v -> z;
 p -> future [style=dashed,label="explicitly deferred; not an MVP prerequisite"];
 note [label="20 TOTAL project hours/week\nLearning / docs / tests / operations included\nNovember 8 and old full-scope sizing are historical",shape=note];
 d -> note [style=dashed];
}
