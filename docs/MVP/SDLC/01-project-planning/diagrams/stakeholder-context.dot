// OWNER-MVP-2026-11-04 review: MVP core / cross-cutting. Core presentation/application/files or shared authority/recovery invariant remains applicable.
digraph StakeholderContext {
  graph [rankdir=LR, bgcolor="white", pad=0.35, ranksep=0.7, nodesep=0.35,
    fontname="Arial", fontsize=19, labelloc=t,
    label="Resumefolio | Stakeholder context\nInterests and relationships - not a permission matrix"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=12,
    color="#CBD5E1", margin="0.2,0.14", fillcolor="#F1F5F9"];
  edge [fontname="Arial", fontsize=10, color="#64748B", arrowsize=0.65];
  owner [label="PROJECT OWNER\nFarhad\nDirection, budget and release decisions", fillcolor="#DBEAFE"];
  product [label="RESUMEFOLIO\nProduct roles do not imply\nadditional delivery staff", fillcolor="#17324D", fontcolor=white];
  admins [label="Platform owner / administrators\nAuthorized administration", fillcolor="#EDE9FE"];
  users [label="Registered users\nProfessional information and related work", fillcolor="#DCFCE7"];
  collaborators [label="Invited collaborators\nAuthorized projects, boards and repositories", fillcolor="#DCFCE7"];
  employers [label="Employers / resume viewers\nSelected shared resume and evidence", fillcolor="#DCFCE7"];
  providers [label="EXTERNAL DEPENDENCIES\nHosting / network, Google services,\nemail delivery\nConditions and availability need validation", fillcolor="#FEF3C7"];
  owner -> product [label="project governance"];
  product -> admins [label="administration interest"];
  product -> users [label="user workflows"];
  product -> collaborators [label="collaboration interest"];
  product -> employers [label="shared-view interest"];
  providers -> product [style=dashed, label="service dependence"];
  {rank=same; owner; providers;}
  {rank=same; admins -> users -> collaborators -> employers [style=invis];}
}
