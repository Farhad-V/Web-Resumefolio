digraph Scope {
graph [rankdir=TB,bgcolor="#0b1220",pad="0.45",nodesep="0.45",ranksep="0.5",fontname="Arial",fontcolor="#e5edf7",label="MVP criterion dispositions",labelloc=t,fontsize=24];
node [shape=box,style="rounded,filled",fontname="Arial",fontcolor="#e5edf7",fontsize=13,color="#40536b",fillcolor="#172337",margin="0.22,0.18"];
edge [color="#8fa6c2",fontcolor="#a9bdd5",fontname="Arial",fontsize=11];
all [label="470 preserved criteria\nScope allocation, not test results",fillcolor="#172337"];
full [label="118  SELECTED MVP\nOriginal check + selected policies",fillcolor="#103b35",color="#49c5ad"];
slice [label="223  MVP SLICE\nExplicit check + scope constraint",fillcolor="#3a2b13",color="#e5b55d"];
future [label="129  AFTER MVP\nNot scheduled for MVP",fillcolor="#29253d",color="#b29be5"];
all -> full;all -> slice;all -> future;
checks [label="Verification gates\nG2 Git / G3 acceptance / G4 restore\nG5 quality / G6 actor review",fillcolor="#142e4c",color="#6ba7ef"];
full -> checks;slice -> checks;
evidence [label="Evidence pending\nSelected checks: Not executed\nRecord actual test/report links after execution",fillcolor="#172337"];
checks -> evidence;
future -> futurework [label="Retained for later planning",style=dashed];
futurework [label="Mail/Calendar · advanced review/merge\nSprints · workflow/deployment runner",fillcolor="#29253d"];
}
