digraph Gates {
graph [rankdir=LR,bgcolor="#0b1220",pad="0.3",ranksep="0.45",fontname="Arial",fontcolor="#e5edf7",label="Selected documentation is the input — runtime evidence comes next",labelloc=t,fontsize=19];
node [shape=box,style="rounded,filled",fontname="Arial",fontcolor="#e5edf7",fontsize=12,margin="0.18,0.16",color="#8fa6c2",fillcolor="#172337"];edge [color="#8fa6c2"];
b [label="G0: BASELINE SELECTED\nTechnical decisions + policies\n157 records / 470 criterion dispositions",fillcolor="#103b35"];
setup [label="G1: SETUP\nResolve patches / lockfiles\nIsolated build + test DB"];
git [label="G2: EARLY SECURITY SPIKE\nSSO / scoped API / real Git\nRevocation / paths / hooks / quotas",fillcolor="#3a2b13"];
core [label="G3: MVP IMPLEMENTATION\nCore journeys / private artifacts\nHistory + ProjectForge acceptance"];
ops [label="G4 + G5\nSMTP / backup + restore\nCapacity / quality / accessibility"];
release [label="G6: RELEASE REVIEW\nActor walkthrough + results\nCandidate / rollback / deployment",fillcolor="#29253d"];
b -> setup -> git -> core -> ops -> release;
note [label="Only G0 is selected now. All runtime gates are NOT RUN.\nNo software Release, deployment or test Pass is created by this document.",shape=note,fillcolor="#283047"];b -> note [style=dashed,arrowhead=none];
}
