digraph MVP {
graph [rankdir=TB,bgcolor="#0b1220",pad="0.35",nodesep="0.45",ranksep="0.6",fontname="Arial",fontcolor="#e5edf7",label="MVP — Selected architecture | BL-MVP-2026-11-04.1",labelloc=t,fontsize=22];
node [shape=box,style="rounded,filled",fillcolor="#172f4b",color="#6ba7ef",fontname="Arial",fontcolor="#e5edf7",fontsize=12,margin="0.2,0.15"];edge [fontname="Arial",fontcolor="#e5edf7",fontsize=10,color="#8fa6c2"];
user [label="Invited user / Admin\nReact + Inertia + Tailwind"];
employer [label="Employer\nPassword link; no account"];
subgraph cluster_host {label="Existing server — separate identities and storage; shared failure domain";fontsize=14;fontsize=14;color="#40536b";style=rounded;
core [label="Resumefolio Core\nLaravel 13 / PHP 8.4\nFortify + Passport"];
pf [label="ProjectForge (separate Laravel service)\nUser-scoped API + independent grants\nIssues / simple Kanban"];
coredb [label="Core MySQL 8.4\nProfile / drafts / publications\nApplications / outbox",shape=cylinder];
media [label="Core PRIVATE files\nMedia / PDF / actual submitted bytes\nOutside public webroot",fillcolor="#103b35"];
pfdb [label="ProjectForge MySQL 8.4\nSeparate DB user / keys / sessions",shape=cylinder];
git [label="Native Git Smart HTTP\nNginx auth_request + fixed CGI\nDedicated Git OS user / bare repos",fillcolor="#103b35"];
core -> coredb;core -> media [label="Current owner/viewer admission"];
pf -> pfdb;pf -> git [label="Per-repo PAT authorization"];
core -> pf [label="5-min scoped JWT + current grants"];
pf -> core [label="PKCE SSO + current account status"];
}
user -> core [label="HTTPS / private session"];user -> pf [label="SSO; separate session"];
employer -> core [label="Scoped viewer session"];
client [label="Git client\nLocal commits + scoped PAT"];client -> git [label="clone / fetch / pull / push"];
backup [label="Independent encrypted backup\nOperator workstation / restic\nConsistent capture + restore gate",fillcolor="#3a2b13"];
coredb -> backup [style=dashed];media -> backup [style=dashed];pfdb -> backup [style=dashed];git -> backup [style=dashed];
future [label="AFTER MVP\nMail/Calendar / AI / advanced Git\nSprints / YAML execution",fillcolor="#29253d",color="#b29be5"];
}
