digraph ScopeBoundaries {
  graph [rankdir=TB, bgcolor="white", pad=0.35, ranksep=0.4, nodesep=0.35,
    fontname="Arial", fontsize=19, labelloc=t,
    label="Resumefolio | Version 1 scope\nAccepted boundaries - technical outcomes still require evidence"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=12,
    color="#CBD5E1", margin="0.2,0.15", fillcolor="#F1F5F9"];
  edge [color="#64748B", arrowsize=0.65];
  scope [label="VERSION 1\nRead together with the scope catalog", fillcolor="#17324D", fontcolor=white];
  included [label="INCLUDED", fillcolor="#DCFCE7"];
  excluded [label="EXCLUDED", fillcolor="#FEE2E2"];
  conditions [label="CONDITIONS AND OPEN DETAILS", fillcolor="#FEF3C7"];
  capabilities [label="Accounts, permissions and unified sign-in\lProfiles, resumes, evidence and PDFs\lPassword-protected employer sharing\lManual ApplyFlow, email and calendar\lKanban, backlog items and Sprints\lReal Git hosting and collaboration\lYAML workflows and CI/CD *\lConfigurable file limits and operations\l", fillcolor="#F0FDF4"];
  limits [label="AI analysis, advice and drafting\lAutomatic resume translation\lAutomatic old-demo data migration\l\nManual English/German content remains\lExisting demo data stays unchanged\l", fillcolor="#FFF1F2"];
  gates [label="Initial target: 10 users on existing server\lFuture 1,000-user capacity is unverified\lNo assumed additional purchases\lDetailed behavior belongs in requirements\l* CI/CD needs security/resource analysis\lProvider access and recovery need evidence\l", fillcolor="#FFFBEB"];
  scope -> included; scope -> excluded; scope -> conditions;
  included -> capabilities; excluded -> limits; conditions -> gates;
  {rank=same; included -> excluded -> conditions [style=invis];}
  {rank=same; capabilities; limits; gates;}
}
