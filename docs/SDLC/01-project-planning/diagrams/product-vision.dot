digraph ProductVision {
    graph [
        label="Resumefolio - Product Vision\nDraft planning view",
        labelloc=t,
        fontsize=22,
        fontname="Arial",
        rankdir=TB,
        bgcolor="white",
        pad=0.4,
        nodesep=0.35,
        ranksep=0.65
    ];

    node [
        shape=box,
        style="rounded,filled",
        fontname="Arial",
        fontsize=12,
        color="#CBD5E1",
        fillcolor="#F1F5F9",
        margin="0.18,0.12"
    ];

    edge [
        color="#64748B",
        arrowsize=0.7
    ];

    vision [
        label="Resumefolio\nManage professional information,\njob applications, and related work",
        fillcolor="#17324D",
        fontcolor="white",
        fontsize=16
    ];

    foundation [
        label="Shared Foundation\nUnified sign-in, consistent experience,\npermissions and controlled access",
        fillcolor="#DBEAFE"
    ];

    presentation [
        label="Professional Presentation",
        fillcolor="#DCFCE7"
    ];

    applications [
        label="Job Application Management",
        fillcolor="#FEF3C7"
    ];

    collaboration [
        label="Work and Collaboration",
        fillcolor="#EDE9FE"
    ];

    profiles [label="Professional profiles"];
    resumes [label="Tailored resumes and portfolio"];
    evidence [label="Supporting media and skill evidence"];
    sharing [label="PDF and password-protected sharing"];

    applyflow [label="Manual ApplyFlow"];
    email [label="Email"];
    calendar [label="Calendar"];

    kanban [label="Kanban and sprints"];
    git [label="Real Git hosting and collaboration"];

    vision -> foundation;

    foundation -> presentation;
    foundation -> applications;
    foundation -> collaboration;

    presentation -> profiles;
    presentation -> resumes;
    presentation -> evidence;
    presentation -> sharing;

    applications -> applyflow;
    applications -> email;
    applications -> calendar;

    collaboration -> kanban;
    collaboration -> git;
}
