digraph ScopeReviewGates {
  graph [rankdir=TB, bgcolor="white", pad=0.35, nodesep=0.45, ranksep=0.4,
    fontname="Arial", fontsize=19, labelloc=t,
    label="Resumefolio | Scope to delivery review gates\nNo dates, capacity guarantee, or implementation claim"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=12,
    color="#CBD5E1", margin="0.2,0.14", fillcolor="#F1F5F9"];
  edge [color="#64748B", arrowsize=0.65, fontname="Arial", fontsize=10];
  inclusion [label="1 | Included in Version 1\nAgree the capability boundary", fillcolor="#DBEAFE"];
  requirements [label="2 | Requirements review\nDefine behavior, permissions and acceptance criteria\nM-02", fillcolor="#DBEAFE"];
  design [label="3 | Analysis, feasibility and design\nJustify choices against resources and risks\nM-03", fillcolor="#FEF3C7"];
  baseline [label="4 | Pre-implementation agreement\nComplete initial SDLC documentation\nReconcile delivery tracking and agree baseline", fillcolor="#EDE9FE"];
  build [label="5 | Implement and verify\nRetain actual results for the identified version\nRelevant capability milestone", fillcolor="#DBEAFE"];
  release [label="6 | Integrated readiness and release decision\nWorkflow evidence, recovery and operating guidance\nM-09 / M-10", fillcolor="#DCFCE7"];
  investigations [label="INVESTIGATE EARLY\nServer resources, Google access, email,\nbackup and safe CI/CD execution\nOwner: project owner", fillcolor="#FFFBEB"];
  inclusion -> requirements -> design -> baseline -> build -> release;
  investigations -> requirements [style=dashed, label="before dependent commitments"];
  investigations -> design [style=dashed];
}
