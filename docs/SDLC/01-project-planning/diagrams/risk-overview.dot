digraph RiskOverview {
  graph [rankdir=TB, bgcolor="white", pad=0.35, ranksep=0.45, nodesep=0.4,
    fontname="Arial", fontsize=19, labelloc=t,
    label="Resumefolio | Initial risk overview\nAll ten open - likelihood unknown - judgments remain preliminary"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=12,
    color="#CBD5E1", margin="0.2,0.15", fillcolor="#F1F5F9"];
  edge [color="#64748B", arrowsize=0.65];
  root [label="RISK FOLLOW-UP\nOwner: Farhad Valizadegan\nWritten response does not mean resolved", fillcolor="#17324D", fontcolor=white];
  capacity [label="DELIVERY AND CAPACITY | High / P1\nRSK-01 | Scope and available time\lRSK-02 | Combined server workloads\lRSK-08 | Upload / storage exhaustion\l", fillcolor="#DBEAFE"];
  security [label="SECURITY AND DATA RULES | High / P1\nRSK-03 | CI/CD execution boundaries\lRSK-04 | Authorization / private data\lRSK-09 | Cross-module data lifecycle\l", fillcolor="#EDE9FE"];
  external [label="RECOVERY AND PROVIDERS | High / P1\nRSK-05 | Unrecoverable data loss\lRSK-06 | Google access / failure\lRSK-07 | Email delivery failure\l", fillcolor="#FEF3C7"];
  maintenance [label="SOLO MAINTENANCE | Medium / P2\nRSK-10 | Maintenance capacity\lReassess upward for critical incidents\lNo assumed separate operations team\l", fillcolor="#F1F5F9"];
  root -> capacity; root -> security; root -> external; root -> maintenance;
  {rank=same; capacity -> security [style=invis];}
  {rank=same; external -> maintenance [style=invis];}
  capacity -> external [style=invis]; security -> maintenance [style=invis];
}
