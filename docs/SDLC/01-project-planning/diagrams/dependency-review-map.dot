digraph DependencyReview {
  graph [rankdir=LR, bgcolor="white", pad=0.35, ranksep=0.7, nodesep=0.3,
    fontname="Arial", fontsize=19, labelloc=t,
    label="Resumefolio | Investigation to review gate\nPlanning traceability - outcomes remain unverified"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=12,
    color="#CBD5E1", margin="0.18,0.13", fillcolor="#DBEAFE"];
  edge [color="#64748B", arrowsize=0.65];
  a1 [label="ASM-01 + DEP-01\nServer capacity and network"];
  a2 [label="ASM-02 + DEP-03\nGoogle operations and access"];
  a3 [label="ASM-03 + DEP-04\nAuthentication / notification email"];
  a4 [label="ASM-04 + DEP-05\nBackup storage and restoration"];
  a5 [label="ASM-05\nTime sufficiency"];
  a6 [label="ASM-06\nRequired user inputs"];
  a7 [label="DEP-02\nDomain, DNS and TLS"];
  a8 [label="DEP-06\nApplication packages and tools"];
  g1 [label="M-03 | Deployment design\nResource findings before commitment", fillcolor="#FEF3C7"];
  g2 [label="M-02 / M-03 | Integration decisions\nVerify access before development", fillcolor="#FEF3C7"];
  g3 [label="M-03 | Delivery-dependent design\nActual checks before capability / release", fillcolor="#FEF3C7"];
  g4 [label="M-03 | Recovery design\nRestoration evidence before M-09", fillcolor="#FEF3C7"];
  g5 [label="After analysis / design\nBefore a credible forecast; revisit Sprints", fillcolor="#FEF3C7"];
  g6 [label="M-02 | Affected workflow acceptance\nAssess incomplete / delayed input", fillcolor="#FEF3C7"];
  g7 [label="M-03 | Deployment configuration\nLive behavior before M-10", fillcolor="#FEF3C7"];
  g8 [label="M-03 | Technical selection\nCompatibility before dependent work", fillcolor="#FEF3C7"];
  a1 -> g1; a2 -> g2; a3 -> g3; a4 -> g4;
  a5 -> g5; a6 -> g6; a7 -> g7; a8 -> g8;
  {rank=same; a1 -> a2 -> a3 -> a4 -> a5 -> a6 -> a7 -> a8 [style=invis];}
  {rank=same; g1; g2; g3; g4; g5; g6; g7; g8;}
}
