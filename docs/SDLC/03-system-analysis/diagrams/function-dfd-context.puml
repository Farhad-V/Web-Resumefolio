@startuml
skinparam backgroundColor white
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 14
skinparam shadowing false
skinparam ArrowColor #486777
skinparam ArrowFontSize 12
skinparam rectangleBackgroundColor #EEF5FA
skinparam rectangleBorderColor #486777
skinparam packageBackgroundColor #F7FAFC
skinparam packageBorderColor #486777
skinparam componentBackgroundColor #EEF5FA
skinparam noteBackgroundColor #FFF3DA
skinparam noteBorderColor #B59865
skinparam nodesep 35
skinparam ranksep 45
skinparam padding 8
title DFD context — external information boundary
left to right direction
rectangle "Private user / collaborator" as human <<external>>
rectangle "Employer viewer" as viewer <<external>>
rectangle "Google services" as google <<external>>
rectangle "Real Git client" as gitclient <<external>>
rectangle "Conditional execution facility" as runner <<external>>
rectangle "Separate deployment target" as target <<external>>
rectangle "Authorized operator / operating facilities" as operator <<external>>
usecase "0\nResumefolio" as P0
human --> P0 : B01a, B02a, B03a, B05a, B06a, B08a, B09a, B11a, B15a
P0 --> human : B01b, B02b, B03b, B05b, B06b, B08b, B09b, B11b, B15b
viewer --> P0 : B04a
P0 --> viewer : B04b
google --> P0 : B07a
P0 --> google : B07b
gitclient --> P0 : B10a
P0 --> gitclient : B10b
runner --> P0 : B12a
P0 --> runner : B12b
target --> P0 : B13a
P0 --> target : B13b
operator --> P0 : B14a
P0 --> operator : B14b

legend bottom
Rectangles: external entities. Ovals: transformations. Bxx a/b: named information in file 04 flow dictionary.
endlegend
@enduml
