@startuml
skinparam backgroundColor white
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundcorner 5
skinparam classAttributeIconSize 0
hide circle
skinparam classBackgroundColor #EDF4FB
skinparam classBorderColor #526B7B
skinparam classHeaderBackgroundColor #DFF1EF
skinparam ArrowColor #526B7B
skinparam ArrowFontSize 11
skinparam noteBackgroundColor #FFF3DF
skinparam noteBorderColor #B99557
skinparam nodesep 35
skinparam ranksep 42
skinparam padding 6
hide empty members
top to bottom direction

title Data — repository identity and evaluated Git context
entity "Repository" as R {
  repository identity
  owner / fork provenance
}
entity "Branch / tag reference" as F {
  repository-scoped name
  target state
}
entity "Git revision" as V {
  repository content context
  evaluated state identity
}
entity "Pull request" as P {
  source + target context
  evaluated revisions / state
}
entity "Review / comment" as C {
  author / target context
  evaluated revision
}
entity "Issue / milestone" as I {
  repository-scoped work identity
  explicit planning association
}
entity "Release" as L {
  release context
  intended tag / revision / assets
}
R ||--o{ F : P: named references
F -- V : resolved target state
R -- P : source / target repository roles
P ||--o{ C : P: attributed discussion / review
P -- V : evaluated source / target
R ||--o{ I : P: repository work
R ||--o{ L : P: releases
L -- V : intended revision context
legend bottom
Conceptual ER view; not tables or foreign keys.
P = explicit working proposal, not owner acceptance.
A = established scope meaning. Unmarked counts are unspecified.
One / optional / many symbols describe relationship ends.
endlegend
@enduml
