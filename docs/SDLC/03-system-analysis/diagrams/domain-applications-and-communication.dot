graph domain {
graph [rankdir=LR,bgcolor="white",pad="0.35",nodesep="0.5",ranksep="0.9",splines=polyline,fontname="Segoe UI",fontsize=15];node [shape=plain,fontname="Segoe UI"];edge [fontname="Segoe UI",fontsize=10,color="#547083",fontcolor="#344f61",penwidth=1.15];
company [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Company</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C14 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Organization context<BR ALIGN="LEFT"/>supplied details</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Record<BR ALIGN="LEFT"/>revise organization context</FONT></TD></TR></TABLE>>];
opportunity [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Job opportunity</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C15 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Role context<BR ALIGN="LEFT"/>source/deadline details</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Record<BR ALIGN="LEFT"/>associate with application</FONT></TD></TR></TABLE>>];
application [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Application record</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C16 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Progress<BR ALIGN="LEFT"/>intended material associations</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Prepare<BR ALIGN="LEFT"/>record progress/submission</FONT></TD></TR></TABLE>>];
letter [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Cover letter</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C17 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Authored text<BR ALIGN="LEFT"/>revision context</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Edit<BR ALIGN="LEFT"/>save preparation</FONT></TD></TR></TABLE>>];
submission [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Submission record</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C18 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Actual event context<BR ALIGN="LEFT"/>capture completeness</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Record submission<BR ALIGN="LEFT"/>record correction</FONT></TD></TR></TABLE>>];
material [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Preserved submitted material</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C19 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Actual content/artifact<BR ALIGN="LEFT"/>provenance</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Capture actual material<BR ALIGN="LEFT"/>identify history</FONT></TD></TR></TABLE>>];
connection [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Provider connection</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C20 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Provider identity<BR ALIGN="LEFT"/>access state</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Connect<BR ALIGN="LEFT"/>disconnect<BR ALIGN="LEFT"/>reconcile access</FONT></TD></TR></TABLE>>];
message [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Email message / draft</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C21 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Message/thread context<BR ALIGN="LEFT"/>content<BR ALIGN="LEFT"/>outcome</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Read<BR ALIGN="LEFT"/>compose<BR ALIGN="LEFT"/>save<BR ALIGN="LEFT"/>send/reply deliberately</FONT></TD></TR></TABLE>>];
activity [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Calendar activity</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C22 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Time/zone<BR ALIGN="LEFT"/>provider mapping if applicable</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Edit<BR ALIGN="LEFT"/>request selected synchronization</FONT></TD></TR></TABLE>>];
reminder [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Activity reminder</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C23 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Activity<BR ALIGN="LEFT"/>recipient/time<BR ALIGN="LEFT"/>outcome</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Schedule<BR ALIGN="LEFT"/>cancel<BR ALIGN="LEFT"/>report outcome</FONT></TD></TR></TABLE>>];
company -- opportunity [label="provides organization context"];
opportunity -- application [label="considered through"];
application -- letter [label="uses editable preparation"];
application -- submission [label="records actual submission"];
submission -- material [label="identifies actual captured set"];
application -- message [label="explicit correspondence association"];
application -- activity [label="explicit activity association"];
connection -- message [label="authorizes provider context"];
connection -- activity [label="authorizes selected provider mapping"];
activity -- reminder [label="has notification intent"];
}