@startuml
skinparam backgroundColor white
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundcorner 5
skinparam classAttributeIconSize 0
hide circle
skinparam classBackgroundColor #EDF4FB
skinparam classBorderColor #526B7B
skinparam classHeaderBackgroundColor #DFF1EF
skinparam ArrowColor #526B7B
skinparam ArrowFontSize 11
skinparam noteBackgroundColor #FFF3DF
skinparam noteBorderColor #B99557
skinparam nodesep 35
skinparam ranksep 42
skinparam padding 6
hide empty members
top to bottom direction

title Data — work identities and one coherent Sprint Backlog
entity "Work project" as P {
  work-project identity
  participant scope
}
entity "Board / column view" as B {
  board identity
  column ordering / state mapping
}
entity "Product Backlog" as K {
  planning context
  item order
}
entity "Backlog Item" as I {
  outcome identity
  criteria / priority / state
}
entity "Task" as T {
  activity identity
  assignment / completion
}
entity "Sprint" as S {
  period identity
  goal / actual outcome
}
entity "Sprint Backlog" as SB {
  goal + selected items + plan
  historical selection context
}
P ||--o{ B : P: work views
P ||--|| K : P: one Product Backlog
K ||--o{ I : P: ordered outcomes
I |o--o{ T : P: optional parent / tasks
P ||--o{ S : P: work periods
S ||--|| SB : A: one coherent Sprint Backlog
SB -- I : selected item / outcome context
SB -- T : delivery plan context
legend bottom
Conceptual ER view; not tables or foreign keys.
P = explicit working proposal, not owner acceptance.
A = established scope meaning. Unmarked counts are unspecified.
One / optional / many symbols describe relationship ends.
endlegend
@enduml
