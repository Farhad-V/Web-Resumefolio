@startuml
skinparam backgroundColor white
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundcorner 5
skinparam classAttributeIconSize 0
hide circle
skinparam classBackgroundColor #EDF4FB
skinparam classBorderColor #526B7B
skinparam classHeaderBackgroundColor #DFF1EF
skinparam ArrowColor #526B7B
skinparam ArrowFontSize 11
skinparam noteBackgroundColor #FFF3DF
skinparam noteBorderColor #B99557
skinparam nodesep 35
skinparam ranksep 42
skinparam padding 6
hide empty members
top to bottom direction

title Data — run provenance, attempts and deployment approval
entity "Workflow definition" as D {
  definition identity / revision
  supported contract context
}
entity "Run" as R {
  code + effective definition
  initiator / actual result
}
entity "Attempt" as A {
  run context / retry lineage
  actual or unknown state
}
entity "Output" as O {
  producing attempt context
  availability / protected content
}
entity "Deployment authorization" as P {
  exact revision / artifact
  target + separate approval
}
entity "Target" as T {
  environment context
  operating / recovery conditions
}
D ||--o{ R : P: evaluated definition
R ||--o{ A : P: actual / retry attempts
A ||--o{ O : P: attributable output
R -- P : evaluated result context
P -- T : target-specific authority
legend bottom
Conceptual ER view; not tables or foreign keys.
P = explicit working proposal, not owner acceptance.
A = established scope meaning. Unmarked counts are unspecified.
One / optional / many symbols describe relationship ends.
endlegend
@enduml
