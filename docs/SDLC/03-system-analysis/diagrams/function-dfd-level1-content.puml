@startuml
skinparam backgroundColor white
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 14
skinparam shadowing false
skinparam ArrowColor #486777
skinparam ArrowFontSize 12
skinparam rectangleBackgroundColor #EEF5FA
skinparam rectangleBorderColor #486777
skinparam packageBackgroundColor #F7FAFC
skinparam packageBorderColor #486777
skinparam componentBackgroundColor #EEF5FA
skinparam noteBackgroundColor #FFF3DA
skinparam noteBorderColor #B59865
skinparam nodesep 35
skinparam ranksep 45
skinparam padding 8
title DFD Level 1 — content
left to right direction
rectangle "Private user / collaborator" as human <<external>>
rectangle "Employer viewer" as viewer <<external>>
rectangle "Google services" as google <<external>>
usecase "F01\nEstablish identity and enforce scoped authority" as F01
usecase "F02\nMaintain independent professional presentation" as F02
usecase "F03\nGenerate PDFs and disclose selected material" as F03
usecase "F04\nManage manual applications and actual history" as F04
usecase "F05\nCoordinate authorized mail and calendar" as F05
human --> F01 : B01a
F01 --> human : B01b
human --> F02 : B02a
F02 --> human : B02b
human --> F03 : B03a
F03 --> human : B03b
human --> F04 : B05a
F04 --> human : B05b
human --> F05 : B06a
F05 --> human : B06b
viewer --> F03 : B04a
F03 --> viewer : B04b
google --> F05 : B07a
F05 --> google : B07b

legend bottom
Two panels form one Level 1 decomposition. Bxx meanings and internal store flows are defined in file 04.
endlegend
@enduml
