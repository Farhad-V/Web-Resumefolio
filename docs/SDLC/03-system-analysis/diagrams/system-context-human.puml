@startuml
skinparam backgroundColor white
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #526B7B
skinparam ArrowFontSize 11
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide circle
skinparam classBackgroundColor #EDF4FB
skinparam classBorderColor #526B7B
skinparam classHeaderBackgroundColor #DFF1EF
skinparam noteBackgroundColor #FFF3DF
skinparam noteBorderColor #B99557
skinparam rectangleBackgroundColor #EDF4FB
skinparam rectangleBorderColor #526B7B
skinparam activityBackgroundColor #EDF4FB
skinparam activityBorderColor #526B7B
skinparam activityDiamondBackgroundColor #DFF1EF
skinparam activityDiamondBorderColor #458F88
skinparam padding 6
skinparam nodesep 35
skinparam ranksep 40
hide empty members
title Resumefolio — human roles and authority contexts
left to right direction
actor "Applicant / resource owner" as O
actor "Employer viewer\nNo product account" as V
actor "Invited collaborator" as C
rectangle "Resumefolio\nLogical product boundary\nSCP-01 through SCP-12" as RF #DFF1EF
actor "Administrator\nSpecified powers only" as A
actor "Platform owner\nFile / storage policy" as P
actor "Project owner / operator" as X
O -- RF : private preparation / intended actions
V -- RF : protected selected viewing
C -- RF : granted work / repository actions
RF -- A : specified administration
RF -- P : effective platform policy
RF .. X : governance / authorized operations
legend bottom
Solid association: interaction context, not an access grant.
Dashed association: governance/operations, not a public endpoint.
One person may hold several roles; no inheritance is implied.
endlegend
@enduml
