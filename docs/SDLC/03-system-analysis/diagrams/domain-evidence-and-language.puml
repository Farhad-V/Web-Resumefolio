@startuml
skinparam backgroundColor white
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #526B7B
skinparam ArrowFontSize 11
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide circle
skinparam classBackgroundColor #EDF4FB
skinparam classBorderColor #526B7B
skinparam classHeaderBackgroundColor #DFF1EF
skinparam noteBackgroundColor #FFF3DF
skinparam noteBorderColor #B99557
skinparam rectangleBackgroundColor #EDF4FB
skinparam rectangleBorderColor #526B7B
skinparam activityBackgroundColor #EDF4FB
skinparam activityBorderColor #526B7B
skinparam activityDiamondBackgroundColor #DFF1EF
skinparam activityDiamondBorderColor #458F88
skinparam padding 6
skinparam nodesep 35
skinparam ranksep 40
hide empty members
title Evidence selection and manually authored language
top to bottom direction
class "Professional entry\nDM-C02" as entry {
  Category
  professional meaning
}
class "Tailored resume\nDM-C03" as resume {
  Content selection
  layout
  tailoring context
}
class "Supporting evidence\nDM-C06" as evidence {
  Category
  supporting association
  content reference
}
class "Evidence selection\nDM-C07" as evidencechoice {
  Selected evidence
  disclosure intent
}
class "Language-specific content\nDM-C08" as language {
  Language
  authored text
  context
}
evidence -down- entry : supports skill / project
resume -down- evidencechoice : selected disclosure
evidencechoice -right- evidence : selected evidence
entry -left- language : authored variants
resume -down- language : intended content language
legend bottom
Solid lines: conceptual associations, not process steps.
Relationship bounds: document 03, section 3.
An unlabeled end is unspecified, not implicitly one.
Properties are semantic, not mandatory database fields.
endlegend
@enduml
