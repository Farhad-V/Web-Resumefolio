graph domain {
graph [rankdir=LR,bgcolor="white",pad="0.35",nodesep="0.5",ranksep="0.9",splines=polyline,fontname="Segoe UI",fontsize=15];node [shape=plain,fontname="Segoe UI"];edge [fontname="Segoe UI",fontsize=10,color="#547083",fontcolor="#344f61",penwidth=1.15];
account [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>User account</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C47 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Identity context<BR ALIGN="LEFT"/>access state</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Identify actor<BR ALIGN="LEFT"/>apply account lifecycle</FONT></TD></TR></TABLE>>];
grant [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Resource authority</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C48 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Subject<BR ALIGN="LEFT"/>resource<BR ALIGN="LEFT"/>allowed action/state</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Evaluate<BR ALIGN="LEFT"/>grant/revoke under authority</FONT></TD></TR></TABLE>>];
file [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Protected file resource</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C49 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Content identity<BR ALIGN="LEFT"/>availability<BR ALIGN="LEFT"/>references</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Admit<BR ALIGN="LEFT"/>retrieve<BR ALIGN="LEFT"/>replace<BR ALIGN="LEFT"/>retire</FONT></TD></TR></TABLE>>];
policy [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>File/storage policy</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C50 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Applicability<BR ALIGN="LEFT"/>units/limits<BR ALIGN="LEFT"/>effective context</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Configure<BR ALIGN="LEFT"/>evaluate policy</FONT></TD></TR></TABLE>>];
audit [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Operational evidence</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C51 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Actor/context<BR ALIGN="LEFT"/>result<BR ALIGN="LEFT"/>visibility</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Record specified evidence<BR ALIGN="LEFT"/>inspect permitted records</FONT></TD></TR></TABLE>>];
backup [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Backup/recovery record</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C52 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Recovery point<BR ALIGN="LEFT"/>coverage<BR ALIGN="LEFT"/>result</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Identify coverage<BR ALIGN="LEFT"/>record backup outcome</FONT></TD></TR></TABLE>>];
restore [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Restoration assessment</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C53 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Recovery source<BR ALIGN="LEFT"/>findings<BR ALIGN="LEFT"/>outcome</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Assess recovery<BR ALIGN="LEFT"/>report actual result</FONT></TD></TR></TABLE>>];
account -- grant [label="has contextual authority"];
grant -- file [label="controls relevant operation"];
policy -- file [label="constrains admission / accounting"];
grant -- audit [label="restricts evidence access"];
file -- backup [label="may fall within recovery coverage"];
backup -- restore [label="supplies recovery candidate"];
restore -- grant [label="reconciles restored access"];
}