@startuml
skinparam backgroundColor white
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 14
skinparam shadowing false
skinparam ArrowColor #486777
skinparam ArrowFontSize 12
skinparam rectangleBackgroundColor #EEF5FA
skinparam rectangleBorderColor #486777
skinparam packageBackgroundColor #F7FAFC
skinparam packageBorderColor #486777
skinparam componentBackgroundColor #EEF5FA
skinparam noteBackgroundColor #FFF3DA
skinparam noteBorderColor #B59865
skinparam nodesep 35
skinparam ranksep 45
skinparam padding 8
title UML component view — interface responsibilities
top to bottom direction
component "Human / employer entry\nIF-01 / IF-02" as human
component "Logical product boundary\nResource/action/state checks" as product
component "Real Git exchange\nIF-06" as git
component "Selected Google exchange\nIF-04 / IF-05" as google
component "File admission / retrieval\nIF-03" as files
component "Conditional execution / target\nIF-07" as execution
component "Operating / recovery exchange\nIF-08" as ops
human --> product : intent / authorized response
git --> product : scoped transfer / result
product --> google : selected provider request / outcome
product --> files : eligible content / disposition
product --> execution : separately eligible request / evidence
product --> ops : applicable operating exchange

legend bottom
Components denote analysis responsibilities only; no deployable services, APIs or internal call chain selected.
endlegend
@enduml
