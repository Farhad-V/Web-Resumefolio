@startuml
skinparam backgroundColor white
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 15
skinparam shadowing false
skinparam roundcorner 10
skinparam ArrowColor #526B7B
skinparam ArrowFontSize 12
skinparam rectangleBorderColor #526B7B
skinparam rectangleBackgroundColor #EDF4FB
skinparam packageBackgroundColor #F6FAFC
skinparam packageBorderColor #458F88
skinparam nodesep 45
skinparam ranksep 55
skinparam padding 10
top to bottom direction
title Resumefolio ecosystem — external connections and evidence status
rectangle "Owner / authorized collaborator / operator\nBrowser and local files [IF-01, IF-03]" as U
rectangle "Employer viewer\nProtected link context [IF-02, IF-03]" as V
rectangle "Real Git client [IF-06]\nPlanned supported interoperability" as GC
package "Resumefolio logical boundary" {
 rectangle "Private workspace\nProfile / portfolio / applications / work\nAdministration and file handling" as H
 rectangle "PDF and protected sharing" as S
 rectangle "Communication\nMail / calendar / provider connection" as C
 rectangle "Product Git hosting" as G
 rectangle "Conditional execution and deployment" as X #FFF3DF
 rectangle "Operating responsibility\nHosting / delivery / recovery" as O
}
rectangle "Google Gmail [IF-04]\nPLANNED — OAuth not created" as M #FFF3DF
rectangle "Google Calendar [IF-05]\nPLANNED — access not established" as CAL #FFF3DF
rectangle "Approved deployment target [IF-07]\nCONDITIONAL — target/runner not selected" as T #FFF3DF
rectangle "Hetzner demo / resumefolio.de [IF-08]\nOBSERVED 2026-11-01: Ubuntu, Nginx\nPHP-FPM, MySQL; 2 vCPU / 4 GB / 40 GB" as HOST #E0F1EE
rectangle "Notification delivery [IF-08]\nUNVERIFIED — service not established\nSeparate from user Gmail" as N #FFF3DF
rectangle "Independent backup / restore facility [IF-08]\nNOT CONFIGURED — destination undecided" as B #FFF3DF
U --> H : actions / file input
H --> U : authorized views / files / outcomes
V --> S : link context / representation request
S --> V : permitted content / denied result
GC --> G : clone / fetch / pull / push requests
G --> GC : objects / refs / actual outcomes
C --> M : authorized read / draft / send / reply
M --> C : permitted messages / provider outcomes
C --> CAL : selected event operations / sync intent
CAL --> C : event versions / provider outcomes
X --> T : separately authorized artifact / revision effect
T --> X : actual result / uncertain outcome
O ..> HOST : observed demo hosting dependence\nnot full-product capacity proof
O --> N : intended notification delivery request
N --> O : attributable delivery disposition
O --> B : eligible protected backup material (planned)
B --> O : authorized isolated recovery input (planned)
H -[hidden]-> C
S -[hidden]-> G
G -[hidden]-> X
X -[hidden]-> O
legend bottom
Solid arrows = intended information direction, NOT proof of an active integration.
Dashed arrow = operating dependence. Status labels qualify every external facility.
Browser/file/Git clients are participants, not independent product platforms.
GitHub development tooling is outside this runtime map; no GitHub/LinkedIn/job-board API is assumed.
Source: file 02 scope inventory; file 12 IF-01–IF-08; dated demo evidence.
endlegend
@enduml
