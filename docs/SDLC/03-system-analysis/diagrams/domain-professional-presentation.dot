graph domain {
graph [rankdir=LR,bgcolor="white",pad="0.35",nodesep="0.5",ranksep="0.9",splines=polyline,fontname="Segoe UI",fontsize=15];node [shape=plain,fontname="Segoe UI"];edge [fontname="Segoe UI",fontsize=10,color="#547083",fontcolor="#344f61",penwidth=1.15];
profile [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Professional profile</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C01 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Professional sections<BR ALIGN="LEFT"/>source context</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Edit source<BR ALIGN="LEFT"/>preview changes</FONT></TD></TR></TABLE>>];
entry [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Professional entry</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C02 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Category<BR ALIGN="LEFT"/>professional meaning</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Maintain source entry</FONT></TD></TR></TABLE>>];
resume [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Tailored resume</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C03 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Content selection<BR ALIGN="LEFT"/>layout<BR ALIGN="LEFT"/>tailoring context</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Compose<BR ALIGN="LEFT"/>apply selected changes<BR ALIGN="LEFT"/>request publication</FONT></TD></TR></TABLE>>];
selection [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Source selection</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C04 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Source reference<BR ALIGN="LEFT"/>inclusion/order</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Select<BR ALIGN="LEFT"/>omit<BR ALIGN="LEFT"/>explicitly apply change</FONT></TD></TR></TABLE>>];
override [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Resume-specific override</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C05 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Target content<BR ALIGN="LEFT"/>independent value</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Edit override<BR ALIGN="LEFT"/>review source difference</FONT></TD></TR></TABLE>>];
evidence [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Supporting evidence</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C06 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Category<BR ALIGN="LEFT"/>supporting association<BR ALIGN="LEFT"/>content reference</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Associate<BR ALIGN="LEFT"/>revise safely</FONT></TD></TR></TABLE>>];
evidencechoice [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Evidence selection</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C07 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Selected evidence<BR ALIGN="LEFT"/>disclosure intent</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Select<BR ALIGN="LEFT"/>omit<BR ALIGN="LEFT"/>review disclosure</FONT></TD></TR></TABLE>>];
language [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Language-specific content</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C08 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Language<BR ALIGN="LEFT"/>authored text<BR ALIGN="LEFT"/>context</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Edit language variant</FONT></TD></TR></TABLE>>];
profile -- entry [label="organizes source information"];
entry -- selection [label="selected as source"];
resume -- selection [label="defines inclusion"];
resume -- override [label="holds independent tailoring"];
entry -- evidence [label="skill / project supported by"];
evidence -- evidencechoice [label="deliberately selected"];
resume -- evidencechoice [label="controls disclosure"];
entry -- language [label="may carry authored variants"];
resume -- language [label="uses intended language context"];
}