@startuml
skinparam backgroundColor white
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundcorner 5
skinparam classAttributeIconSize 0
hide circle
skinparam classBackgroundColor #EDF4FB
skinparam classBorderColor #526B7B
skinparam classHeaderBackgroundColor #DFF1EF
skinparam ArrowColor #526B7B
skinparam ArrowFontSize 11
skinparam noteBackgroundColor #FFF3DF
skinparam noteBorderColor #B99557
skinparam nodesep 35
skinparam ranksep 42
skinparam padding 6
hide empty members
top to bottom direction

title Data — evidence disclosure and language context
entity "Tailored resume" as R {
  resume identity
  intended content language
}
entity "Evidence selection" as S {
  resume context
  evidence identity / order
}
entity "Supporting evidence" as E {
  evidence identity
  content / file / link reference
}
entity "Skill / professional-project entry" as P {
  entry identity
  supporting context
}
entity "Language-specific content" as L {
  owning content context
  language + authored wording
}
R ||--o{ S : P: selected disclosure
E ||--o{ S : P: selected evidence reference
E }o--o{ P : P: permitted supporting associations
P -- L : P: source wording context
R -- L : P: tailored wording context
legend bottom
Conceptual ER view; not tables or foreign keys.
P = explicit working proposal, not owner acceptance.
A = established scope meaning. Unmarked counts are unspecified.
One / optional / many symbols describe relationship ends.
endlegend
@enduml
