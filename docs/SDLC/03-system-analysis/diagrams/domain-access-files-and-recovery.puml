@startuml
skinparam backgroundColor white
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #526B7B
skinparam ArrowFontSize 11
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide circle
skinparam classBackgroundColor #EDF4FB
skinparam classBorderColor #526B7B
skinparam classHeaderBackgroundColor #DFF1EF
skinparam noteBackgroundColor #FFF3DF
skinparam noteBorderColor #B99557
skinparam rectangleBackgroundColor #EDF4FB
skinparam rectangleBorderColor #526B7B
skinparam activityBackgroundColor #EDF4FB
skinparam activityBorderColor #526B7B
skinparam activityDiamondBackgroundColor #DFF1EF
skinparam activityDiamondBorderColor #458F88
skinparam padding 6
skinparam nodesep 35
skinparam ranksep 40
hide empty members
title Contextual authority, file policy and recoverable data
top to bottom direction
class "User account\nDM-C47" as account {
  Identity context
  access state
}
class "Resource authority\nDM-C48" as grant {
  Subject
  resource
  allowed action/state
}
class "Protected file resource\nDM-C49" as file {
  Content identity
  availability
  references
}
class "File/storage policy\nDM-C50" as policy {
  Applicability
  units/limits
  effective context
}
class "Operational evidence\nDM-C51" as audit {
  Actor/context
  result
  visibility
}
class "Backup/recovery record\nDM-C52" as backup {
  Recovery point
  coverage
  result
}
class "Restoration assessment\nDM-C53" as restore {
  Recovery source
  findings
  outcome
}
account -- grant : actor context
grant -- file : operation authority
policy -- file : applicable policy
grant -- audit : restricted evidence access
file -- backup : identified coverage
backup -- restore : recovery candidate
restore -- grant : restored-access reconciliation
legend bottom
Solid lines: conceptual associations, not process steps.
Relationship bounds: document 03, section 3.
An unlabeled end is unspecified, not implicitly one.
Properties are semantic, not mandatory database fields.
endlegend
@enduml
