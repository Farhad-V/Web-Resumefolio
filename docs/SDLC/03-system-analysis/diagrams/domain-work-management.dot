graph domain {
graph [rankdir=LR,bgcolor="white",pad="0.35",nodesep="0.5",ranksep="0.9",splines=polyline,fontname="Segoe UI",fontsize=15];node [shape=plain,fontname="Segoe UI"];edge [fontname="Segoe UI",fontsize=10,color="#547083",fontcolor="#344f61",penwidth=1.15];
project [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Work project</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C24 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Work identity<BR ALIGN="LEFT"/>participant context</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Organize permitted work</FONT></TD></TR></TABLE>>];
board [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Board</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C25 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Displayed work<BR ALIGN="LEFT"/>column arrangement</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Configure view<BR ALIGN="LEFT"/>request movement</FONT></TD></TR></TABLE>>];
column [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Board column</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C26 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Label/order<BR ALIGN="LEFT"/>state mapping meaning</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Configure<BR ALIGN="LEFT"/>map valid movement</FONT></TD></TR></TABLE>>];
backlog [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Product Backlog</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C27 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Item ordering<BR ALIGN="LEFT"/>planning context</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Add<BR ALIGN="LEFT"/>order<BR ALIGN="LEFT"/>refine items</FONT></TD></TR></TABLE>>];
item [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Backlog Item</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C28 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Outcome<BR ALIGN="LEFT"/>priority<BR ALIGN="LEFT"/>criteria<BR ALIGN="LEFT"/>state</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Refine<BR ALIGN="LEFT"/>select<BR ALIGN="LEFT"/>evaluate completion</FONT></TD></TR></TABLE>>];
task [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Task</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C29 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Activity<BR ALIGN="LEFT"/>assignment<BR ALIGN="LEFT"/>due/state context</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Assign<BR ALIGN="LEFT"/>update<BR ALIGN="LEFT"/>complete activity</FONT></TD></TR></TABLE>>];
sprint [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Sprint</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C30 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Period<BR ALIGN="LEFT"/>lifecycle<BR ALIGN="LEFT"/>outcome</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Start<BR ALIGN="LEFT"/>adapt<BR ALIGN="LEFT"/>end under authority</FONT></TD></TR></TABLE>>];
sprintbacklog [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#547083"><TR><TD BGCOLOR="#163e52"><FONT COLOR="white" POINT-SIZE="12"><B>Sprint Backlog</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">DM-C31 · conceptual responsibility</FONT></TD></TR><TR><TD BGCOLOR="#edf4fb" ALIGN="LEFT"><FONT POINT-SIZE="10">Goal + selected items + plan</FONT></TD></TR><TR><TD BGCOLOR="#dff1ef" ALIGN="LEFT"><FONT POINT-SIZE="10">Select work<BR ALIGN="LEFT"/>adapt plan<BR ALIGN="LEFT"/>retain outcome</FONT></TD></TR></TABLE>>];
project -- board [label="organizes work views"];
board -- column [label="configures workflow display"];
project -- backlog [label="organizes planned outcomes"];
backlog -- item [label="orders work"];
item -- task [label="may be refined into"];
project -- sprint [label="plans work period"];
sprint -- sprintbacklog [label="has one coherent backlog"];
sprintbacklog -- item [label="selects intended outcomes"];
sprintbacklog -- task [label="includes delivery plan activities"];
}