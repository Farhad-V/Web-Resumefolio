@startuml
skinparam backgroundColor white
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 14
skinparam shadowing false
skinparam ArrowColor #486777
skinparam ArrowFontSize 12
skinparam rectangleBackgroundColor #EEF5FA
skinparam rectangleBorderColor #486777
skinparam packageBackgroundColor #F7FAFC
skinparam packageBorderColor #486777
skinparam componentBackgroundColor #EEF5FA
skinparam noteBackgroundColor #FFF3DA
skinparam noteBorderColor #B59865
skinparam nodesep 35
skinparam ranksep 45
skinparam padding 8
title UML packages — logical domain groupings
top to bottom direction
package "Professional presentation" as presentation {
 class "Profile / tailored resume\nSelected evidence / publication" as P
}
package "Application history" as application {
 class "Opportunity / progress\nActual submitted material" as A
}
package "Communication" as communication {
 class "Provider connection\nMail / calendar context" as C
}
package "Work management" as work {
 class "Project / work item\nTask / Sprint Backlog" as W
}
package "Repository collaboration" as git {
 class "Repository / revision\nPull request / review" as G
}
package "Conditional execution" as execution {
 class "Workflow / attempt\nArtifact / deployment effect" as X
}
package "Cross-cutting authority and lifecycle" as authority {
 class "Account / scoped grant\nFile / policy / recovery" as S
}
application ..> presentation : selected preparation references
application ..> communication : deliberate correspondence context
execution ..> git : exact revision provenance
work ..> git : deliberate work links
presentation ..> authority : scoped access / lifecycle
communication ..> authority : independent connection authority
execution ..> authority : scoped execution and target authority

legend bottom
Conceptual grouping and selected dependencies only; not modules, services or code packages.
endlegend
@enduml
