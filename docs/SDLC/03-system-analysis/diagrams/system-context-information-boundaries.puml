@startuml
skinparam backgroundColor white
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #526B7B
skinparam ArrowFontSize 11
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide circle
skinparam classBackgroundColor #EDF4FB
skinparam classBorderColor #526B7B
skinparam classHeaderBackgroundColor #DFF1EF
skinparam noteBackgroundColor #FFF3DF
skinparam noteBorderColor #B99557
skinparam rectangleBackgroundColor #EDF4FB
skinparam rectangleBorderColor #526B7B
skinparam activityBackgroundColor #EDF4FB
skinparam activityBorderColor #526B7B
skinparam activityDiamondBackgroundColor #DFF1EF
skinparam activityDiamondBorderColor #458F88
skinparam padding 6
skinparam nodesep 35
skinparam ranksep 40
hide empty members
title Information authority — edit, publish, retrieve and preserve
top to bottom direction
actor "Resource owner" as O
actor "Employer viewer" as V
rectangle "Resumefolio — logical responsibility" {
 rectangle "Private working information\nShared profile + independent resumes" as W
 rectangle "Selected published presentation" as P #DFF1EF
 rectangle "Actual submitted material\nPreserved independently" as H #FFF3DF
 rectangle "Current retrieval decision\nActor / resource / action / state" as A
 W ..> P : explicit selected apply,\nthen separate publication
 W ..> H : actual submitted content capture\nnot an automatic live-copy operation
 P --> A : selected available content
}
O --> W : authorized preparation
O ..> P : separate publication confirmation
V --> A : protected page / file / PDF request
A --> V : scoped result or denial / unavailable
legend bottom
Solid arrows: request/content/result direction. Dashed arrows:
explicit authority or provenance, not automatic propagation.
No published-view-to-history synchronization is implied.
endlegend
@enduml
