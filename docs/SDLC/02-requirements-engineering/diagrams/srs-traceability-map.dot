digraph model {
graph [bgcolor="white",pad=0.3,nodesep=0.4,ranksep=0.65,fontname="Arial",fontsize=20,labelloc=t];
node [shape=box,style="rounded,filled",fillcolor="#DBEAFE",color="#64748B",fontcolor="#17324D",fontname="Arial",fontsize=13,margin="0.18,0.14"];
edge [color="#64748B",fontname="Arial",fontsize=11,fontcolor="#17324D"];
graph [rankdir=TB,label="Resumefolio | SRS relationships to maintain"];
source [label="Accepted intent and actual sources
Scope / constraints / elicitation"];
goals [label="Proposed business + user outcomes
BIZ-D / USR-D",fillcolor="#EDE9FE"];
req [label="Primary behavior / cross-cutting records
Domain + interface + lifecycle + quality"];
support [label="Scenarios + dictionary + decisions
Consistent meaning / explicit questions",fillcolor="#FEF3C7"];
design [label="Later justified design / implementation
Identified candidate and configuration"];
evidence [label="Actual review / verification evidence
Method + outcome + limits",fillcolor="#DCFCE7"];
decision [label="Separate owner dispositions
Requirements baseline / capability / release",fillcolor="#EDE9FE"];
source -> goals; goals -> req; support -> req [dir=both];
req -> design; req -> evidence [label="criteria"];
design -> evidence [label="actual candidate"];
evidence -> decision;
}
