digraph ManagementTraceability {
 graph [rankdir=TB,bgcolor="white",pad=0.35,ranksep=0.5,nodesep=0.4,fontname="Arial",fontsize=20,labelloc=t,
 label="Resumefolio | Requirements traceability\nRelationships are navigable both ways - actual artifacts may still be pending"];
 node [shape=box,style="rounded,filled",fontname="Arial",fontsize=13,color="#64748B",fontcolor="#17324D",margin="0.22,0.16",fillcolor="#DBEAFE"];
 edge [color="#64748B",arrowsize=0.7,dir=both,fontname="Arial",fontsize=11];
 source [label="SOURCES / OBJECTIVES / SCOPE\nExact context and accepted decisions",fillcolor="#17324D",fontcolor=white];
 requirement [label="REQUIREMENT / RULE\nStable identity + revision + actual state\nBehavior, rationale and dependencies"];
 views [label="SCENARIOS / CRITERIA / DEFINITIONS\nNormal, denied and failure paths\nMeaningful coverage and planned verification"];
 delivery [label="WORK / DESIGN\nLive work tracking and actual design records\nLinked to the relevant requirement revision",fillcolor="#EDE9FE"];
 evidence [label="LATER VERIFICATION EVIDENCE\nCandidate, environment and criterion revision\nActual results and limitations",fillcolor="#DCFCE7"];
 change [label="CHANGE / QUESTION / REVIEW CONTEXT\nImpact, owner, next action and gate\nActual decisions and preserved history",fillcolor="#FEF3C7"];
 source -> requirement;
 requirement -> views;
 views -> delivery;
 delivery -> evidence;
 requirement -> change [style=dashed];
 change -> evidence [style=dashed,label="evidence applicability"];
 {rank=same;requirement;change;}
}
