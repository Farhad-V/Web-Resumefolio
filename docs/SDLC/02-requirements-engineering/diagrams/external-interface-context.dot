digraph interfaces {
 graph [rankdir=LR,bgcolor="white",pad=0.3,nodesep=0.35,ranksep=0.7,fontname="Arial",fontsize=20,label="Resumefolio | External interface inventory",labelloc=t];
 node [shape=box,style="rounded,filled",fillcolor="#DBEAFE",color="#64748B",fontcolor="#17324D",fontname="Arial",fontsize=13,margin="0.18,0.14"];
 edge [color="#64748B",fontname="Arial",fontsize=11,fontcolor="#17324D",dir=none];
 user [label="Product user / authorized collaborator
IF-01: scoped private UI"];
 employer [label="Employer viewer without account
IF-02: selected protected content"];
 files [label="Authorized file exchange
IF-03: evidence / PDFs / agreed assets"];
 git [label="Real Git client
IF-06: agreed repository operations"];
 product [label="Resumefolio product boundary
Resource/action authority
Defined inputs, results and lifecycle",fillcolor="#EDE9FE"];
 gmail [label="IF-04: Gmail
Selected account / required permissions"];
 cal [label="IF-05: Google Calendar
Explicit synchronization contract"];
 exec [label="IF-07: Execution / deployment boundary
Conditional feasibility + security gates",fillcolor="#FEF3C7"];
 ops [label="IF-08: Operational dependencies
Selected runtime / delivery / recovery
Actual facilities remain to be verified",fillcolor="#DCFCE7"];
 user -> product; employer -> product; files -> product; git -> product;
 product -> gmail; product -> cal; product -> exec; product -> ops;
 {rank=same;user;employer;files;git;}
 {rank=same;gmail;cal;exec;ops;}
}