digraph DataDefinitions {
 graph [rankdir=TB,bgcolor="white",pad=0.35,ranksep=0.5,nodesep=0.4,fontname="Arial",fontsize=20,labelloc=t,
 label="Resumefolio | Conceptual information map\nWorking definitions - not a database schema or permission model"];
 node [shape=box,style="rounded,filled",fontname="Arial",fontsize=13,color="#64748B",fontcolor="#17324D",margin="0.22,0.16",fillcolor="#DBEAFE"];
 edge [color="#64748B",arrowsize=0.7,fontname="Arial",fontsize=11];
 account [label="ACCOUNT / RESOURCE CONTEXT\nOwnership and permitted operations\nDetailed draft policies await review",fillcolor="#17324D",fontcolor=white];
 profile [label="PROFESSIONAL PRESENTATION\nProfile + tailored resume + selected evidence\nGenerated / uploaded PDFs + sharing"];
 application [label="MANUAL APPLICATIONS\nCompany / opportunity + cover letter\nApplication record and progress",fillcolor="#FEF3C7"];
 communications [label="COMMUNICATION / SCHEDULING\nProvider connections + email\nCalendar activities + reminders",fillcolor="#FEF3C7"];
 work [label="WORK AND CODE COLLABORATION\nProjects / boards / backlogs / Sprints / tasks\nRepositories / reviews / releases / workflows",fillcolor="#EDE9FE"];
 submitted [label="PRESERVED SUBMITTED MATERIALS\nWhat was actually submitted\nLater source edits do not overwrite copies",fillcolor="#DCFCE7"];
 operations [label="OPERATIONAL INFORMATION\nFile policy + relevant audit information\nRun outputs + backup / recovery records",fillcolor="#F1F5F9"];
 account -> profile [label="owner / access context"];
 account -> application [label="owner / access context"];
 account -> work [label="owner / member context"];
 application -> communications [label="related communications / dates"];
 profile -> application [label="selected resume"];
 application -> submitted [label="preserves submitted materials"];
 profile -> submitted [label="submitted content under explicit capture rules",style=dashed];
 work -> operations [label="execution / operational context",style=dashed];
 {rank=same;profile;application;work;}
 {rank=same;submitted;communications;operations;}
}
