digraph FilePolicy {
 graph [rankdir=TB,bgcolor="white",pad=0.35,ranksep=0.5,nodesep=0.4,fontname="Arial",fontsize=20,labelloc=t,
 label="Resumefolio | Administration and file policy\nProposed requirements relationships - limits and lifecycle policies remain open"];
 node [shape=box,style="rounded,filled",fontname="Arial",fontsize=13,color="#64748B",fontcolor="#17324D",margin="0.22,0.16",fillcolor="#DBEAFE"];
 edge [color="#64748B",arrowsize=0.7,fontname="Arial",fontsize=11];
 authority [label="EXPLICIT ADMINISTRATIVE AUTHORITY\nPlatform-owner policy configuration\nOther powers require defined grants",fillcolor="#FEF3C7"];
 capacity [label="ACTUAL RESOURCE FINDINGS\nInfrastructure and processing constraints\nCapacity is not created by configuration",fillcolor="#FEF3C7"];
 policy [label="EFFECTIVE FILE POLICY\nFormats, size rules and storage accounting\nScopes / units / defaults still to define",fillcolor="#17324D",fontcolor=white];
 operation [label="AUTHORIZED FILE OPERATIONS\nAdmission, processing, association and retrieval\nBoundaries apply to direct requests"];
 lifecycle [label="CROSS-MODULE LIFECYCLE\nReplacement / references / submitted copies\nRetention, restore and cleanup rules",fillcolor="#EDE9FE"];
 outcome [label="TRUTHFUL OUTCOME AND OPERABILITY\nNo false usable success for failed work\nDefined warnings / evidence / versioned guidance",fillcolor="#DCFCE7"];
 authority -> policy [label="authorized changes"];
 capacity -> policy [label="evaluated constraints"];
 policy -> operation [label="enforced eligibility / limits"];
 lifecycle -> operation [label="applicable ownership / retention rules",style=dashed];
 operation -> outcome;
 lifecycle -> outcome [style=dashed,label="preservation / accounting"];
 {rank=same;authority;capacity;}
 {rank=same;operation;lifecycle;}
}
