digraph work {
 graph [rankdir=TB,bgcolor="white",pad=0.3,nodesep=0.5,ranksep=0.75,fontname="Arial",fontsize=20,label="Resumefolio | Work and Sprint concepts",labelloc=t];
 node [shape=box,style="rounded,filled",fillcolor="#DBEAFE",color="#64748B",fontcolor="#17324D",fontname="Arial",fontsize=13,margin="0.18,0.14"];
 edge [color="#64748B",fontname="Arial",fontsize=11,fontcolor="#17324D"];
 context [label="Authorized work context
Project / participant grants"];
 backlog [label="Product Backlog
List of identifiable Backlog Items"];
 item [label="Backlog Item
Feature / defect / improvement / investigation"];
 task [label="Tasks
Specific delivery activities
Assignment / priority / due date"];
 board [label="Board + configurable columns
Representation / state mapping pending",fillcolor="#FEF3C7"];
 sprint [label="Sprint
Defined work period and goal",fillcolor="#EDE9FE"];
 sb [label="One Sprint Backlog
Sprint Goal + selected items
+ delivery plan",fillcolor="#DCFCE7"];
 context -> backlog [label="defined scope"];
 backlog -> item [label="contains"];
 item -> task [label="may be refined into"];
 context -> board [label="authorized visualization"];
 context -> sprint [label="defined planning context"];
 item -> sb [label="selected work"];
 sprint -> sb [label="its goal and plan"];
 task -> sb [label="plan relationship if defined",style=dashed];
}