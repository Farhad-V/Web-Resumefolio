digraph model {
graph [rankdir=TB,bgcolor="white",pad=0.3,nodesep=0.4,ranksep=0.65,fontname="Arial",fontsize=20,labelloc=t];
node [shape=box,style="rounded,filled",fillcolor="#DBEAFE",color="#64748B",fontcolor="#17324D",fontname="Arial",fontsize=13,margin="0.18,0.14"];
edge [color="#64748B",fontname="Arial",fontsize=11,fontcolor="#17324D"];
graph [label="Resumefolio | Stories, use cases and scenario paths"];
source [label="Sourced actor outcome
USR-D + accepted scope"];
story [label="ST-D: user value
As actor, want outcome, so that benefit",fillcolor="#EDE9FE"];
uc [label="UC-D: goal bundle
Trigger + preconditions + boundary
Detailed criteria / open decisions"];
n [label="N: normal
Steps + success state",fillcolor="#DCFCE7"];
a [label="A: alternative
Changed valid condition"];
d [label="D: denied
No prohibited effect / disclosure",fillcolor="#FEF3C7"];
f [label="F: failure
Truthful partial / failed outcome",fillcolor="#FEF3C7"];
r [label="R: recovery / correction
Explicit reconciliation policy"];
evidence [label="Separate later review / execution evidence
Path drafts do not establish Pass results",fillcolor="#EDE9FE"];
source -> story; story -> uc;
uc -> n; uc -> a; uc -> d; uc -> f; uc -> r;
n -> evidence; a -> evidence; d -> evidence; f -> evidence; r -> evidence;
}
