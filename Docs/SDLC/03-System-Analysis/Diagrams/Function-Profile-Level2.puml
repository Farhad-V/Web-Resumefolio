@startuml
' OWNER-MVP-2026-11-04 review: MVP core / cross-cutting. Core presentation/application/files or shared authority/recovery invariant remains applicable.
skinparam backgroundColor white
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 14
skinparam shadowing false
skinparam ArrowColor #486777
skinparam ArrowFontSize 12
skinparam rectangleBackgroundColor #EEF5FA
skinparam rectangleBorderColor #486777
skinparam packageBackgroundColor #F7FAFC
skinparam packageBorderColor #486777
skinparam componentBackgroundColor #EEF5FA
skinparam noteBackgroundColor #FFF3DA
skinparam noteBorderColor #B59865
skinparam nodesep 35
skinparam ranksep 45
skinparam padding 8
title DFD Level 2 — F02 selected apply and publication
top to bottom direction
rectangle "Owner" as owner
usecase "F02.1\nMaintain source" as source
usecase "F02.2\nApply selected changes" as apply
usecase "F02.3\nPublish separately" as publish
database "D2a Source content" as src
database "D2b Independent draft" as draft
database "D2c Live presentation" as live
owner --> source : B02a source edits
owner --> apply : B02a selected apply intent
owner --> publish : B02a separate publish intent
source --> owner : B02b source-save outcome
apply --> owner : B02b draft outcome
publish --> owner : B02b publication outcome
source --> src : confirmed source change
src --> source : current source
src --> apply : selected current source
draft --> apply : current draft / overrides
apply --> draft : confirmed selected draft change
draft --> publish : separately confirmed intended presentation
live --> publish : current live context
publish --> live : confirmed publication

legend bottom
B02 decomposed by intent, not additional boundary information. No source-to-live or draft-to-submitted-history automatic flow.
endlegend
@enduml
