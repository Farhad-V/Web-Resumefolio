<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_process-bpmn-target-publication" targetNamespace="https://resumefolio.de/analysis" exporter="Resumefolio documentation"><bpmn:collaboration id="Collaboration"><bpmn:participant id="Participant" name="Target profile apply/publication — selected confirmed-success path" processRef="Process" /></bpmn:collaboration><bpmn:process id="Process" isExecutable="false"><bpmn:laneSet id="Lanes"><bpmn:lane id="OwnerLane" name="Owner"><bpmn:flowNodeRef>start</bpmn:flowNodeRef><bpmn:flowNodeRef>review</bpmn:flowNodeRef><bpmn:flowNodeRef>confirm</bpmn:flowNodeRef><bpmn:flowNodeRef>choice</bpmn:flowNodeRef><bpmn:flowNodeRef>endDraft</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="SystemLane" name="Resumefolio"><bpmn:flowNodeRef>apply</bpmn:flowNodeRef><bpmn:flowNodeRef>publish</bpmn:flowNodeRef><bpmn:flowNodeRef>endLive</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="start" name="Selected change" /><bpmn:task id="review" name="Review and confirm selected apply" /><bpmn:task id="apply" name="Apply selected change; preserve overrides" /><bpmn:task id="confirm" name="Decide separate publication" /><bpmn:exclusiveGateway id="choice" name="Publish?" /><bpmn:task id="publish" name="Publish separately confirmed presentation" /><bpmn:endEvent id="endDraft" name="Draft saved only" /><bpmn:endEvent id="endLive" name="Presentation published" /><bpmn:sequenceFlow id="Flow0" sourceRef="start" targetRef="review" name="" /><bpmn:sequenceFlow id="Flow1" sourceRef="review" targetRef="apply" name="" /><bpmn:sequenceFlow id="Flow2" sourceRef="apply" targetRef="confirm" name="confirmed apply" /><bpmn:sequenceFlow id="Flow3" sourceRef="confirm" targetRef="choice" name="" /><bpmn:sequenceFlow id="Flow4" sourceRef="choice" targetRef="publish" name="yes"><bpmn:conditionExpression>separate publication confirmed</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow5" sourceRef="choice" targetRef="endDraft" name="no"><bpmn:conditionExpression>publication not requested</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow6" sourceRef="publish" targetRef="endLive" name="confirmed publish" /></bpmn:process><bpmndi:BPMNDiagram id="Diagram"><bpmndi:BPMNPlane id="Plane" bpmnElement="Collaboration"><bpmndi:BPMNShape id="ParticipantShape" bpmnElement="Participant" isHorizontal="false"><dc:Bounds x="30" y="90" width="740" height="500" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="OwnerLaneShape" bpmnElement="OwnerLane" isHorizontal="false"><dc:Bounds x="60" y="120" width="350" height="470" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="SystemLaneShape" bpmnElement="SystemLane" isHorizontal="false"><dc:Bounds x="410" y="120" width="350" height="470" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="startShape" bpmnElement="start"><dc:Bounds x="130" y="140" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="reviewShape" bpmnElement="review"><dc:Bounds x="80" y="220" width="200" height="65" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="applyShape" bpmnElement="apply"><dc:Bounds x="490" y="220" width="220" height="65" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="confirmShape" bpmnElement="confirm"><dc:Bounds x="80" y="360" width="200" height="65" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="choiceShape" bpmnElement="choice"><dc:Bounds x="320" y="365" width="55" height="55" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="publishShape" bpmnElement="publish"><dc:Bounds x="490" y="360" width="220" height="65" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="endDraftShape" bpmnElement="endDraft"><dc:Bounds x="150" y="510" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="endLiveShape" bpmnElement="endLive"><dc:Bounds x="590" y="510" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNEdge 