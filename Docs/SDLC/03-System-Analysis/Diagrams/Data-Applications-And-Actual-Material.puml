@startuml
' OWNER-MVP-2026-11-04 review: MVP core. Manual applications stay in MVP regardless of a historical communication filename.
skinparam backgroundColor #0D1525
skinparam defaultFontColor #EDF4FF
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundcorner 5
skinparam classAttributeIconSize 0
hide circle
skinparam classBackgroundColor #1A2940
skinparam classBorderColor #91AED1
skinparam classHeaderBackgroundColor #17405A
skinparam ArrowColor #91AED1
skinparam ArrowFontSize 11
skinparam noteBackgroundColor #4A302B
skinparam noteBorderColor #F1AD8A
skinparam nodesep 35
skinparam ranksep 42
hide empty members
top to bottom direction

title Data — application preparation and actual submission records
entity "Company" as C {
  organization context
  user-supplied description
}
entity "Opportunity" as J {
  position identity / context
  company association
}
entity "Application" as A {
  application identity
  intended opportunity / progress
}
entity "Editable cover letter" as L {
  content identity
  application context
}
entity "Submission record" as S {
  actual event context
  material completeness / attribution
}
entity "Actual submitted material" as M {
  material identity
  captured content / provenance
}
C ||-right-o{ J : P: organization context
J ||--o{ A : P: considered applications
A -- L : editable preparation
A ||--o{ S : P: recorded submissions
S ||-right-o{ M : P: actual material set
legend bottom
Conceptual ER view; not tables or foreign keys.
P = explicit working proposal, not owner acceptance.
A = established scope meaning. Unmarked counts are unspecified.
One / optional / many symbols describe relationship ends.
endlegend
note "MVP manual application: status, next action and follow-up date.\nPreserve actual submitted materials; no mail/calendar dependency." as MVPFollowUp
@enduml
