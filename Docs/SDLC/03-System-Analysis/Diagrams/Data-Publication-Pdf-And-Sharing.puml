@startuml
' OWNER-MVP-2026-11-04 review: MVP core / cross-cutting. Core presentation/application/files or shared authority/recovery invariant remains applicable.
skinparam backgroundColor #0D1525
skinparam defaultFontColor #EDF4FF
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundcorner 5
skinparam classAttributeIconSize 0
hide circle
skinparam classBackgroundColor #1A2940
skinparam classBorderColor #91AED1
skinparam classHeaderBackgroundColor #17405A
skinparam ArrowColor #91AED1
skinparam ArrowFontSize 11
skinparam noteBackgroundColor #4A302B
skinparam noteBorderColor #F1AD8A
skinparam nodesep 35
skinparam ranksep 42
hide empty members
top to bottom direction

title Data — publication identity, PDF provenance and access
entity "Tailored resume" as R {
  resume identity
  editable context
}
entity "Published presentation" as P {
  effective content identity
  language / selection context
}
entity "Generated PDF" as G {
  represented content identity
  language / availability
}
entity "Uploaded PDF" as U {
  supplied artifact identity
  language / provenance
}
entity "Download availability" as D {
  resume context
  generated / uploaded / both / neither
}
entity "Protected employer link" as L {
  link identity
  resume scope / access state
}
R ||--o{ P : P: publication contexts
P ||--o{ G : P: employer-facing renditions
R ||--o{ U : P: independent supplied renditions
R -- D : per-resume configuration
L }o--|| R : P: intended resume stream
legend bottom
Conceptual ER view; not tables or foreign keys.
P = explicit working proposal, not owner acceptance.
A = established scope meaning. Unmarked counts are unspecified.
One / optional / many symbols describe relationship ends.
endlegend
@enduml
