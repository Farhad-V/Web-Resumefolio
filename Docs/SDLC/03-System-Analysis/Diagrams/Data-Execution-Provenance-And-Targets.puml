@startuml
' OWNER-MVP-2026-11-04 review: Future after MVP. Provider, advanced Sprint/review, or untrusted execution requirement retained as deferred.
skinparam backgroundColor #0D1525
skinparam defaultFontColor #EDF4FF
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundcorner 5
skinparam classAttributeIconSize 0
hide circle
skinparam classBackgroundColor #1A2940
skinparam classBorderColor #91AED1
skinparam classHeaderBackgroundColor #17405A
skinparam ArrowColor #91AED1
skinparam ArrowFontSize 11
skinparam noteBackgroundColor #4A302B
skinparam noteBorderColor #F1AD8A
skinparam nodesep 35
skinparam ranksep 42
hide empty members
top to bottom direction

title AFTER MVP — Data — run provenance, attempts and deployment approval
entity "Workflow definition" as D {
  definition identity / revision
  supported contract context
}
entity "Run" as R {
  code + effective definition
  initiator / actual result
}
entity "Attempt" as A {
  run context / retry lineage
  actual or unknown state
}
entity "Output" as O {
  producing attempt context
  availability / protected content
}
entity "Deployment authorization" as P {
  exact revision / artifact
  target + separate approval
}
entity "Target" as T {
  environment context
  operating / recovery conditions
}
D ||--o{ R : P: evaluated definition
R ||--o{ A : P: actual / retry attempts
A ||--o{ O : P: attributable output
R -- P : evaluated result context
P -- T : target-specific authority
legend bottom
Conceptual ER view; not tables or foreign keys.
P = explicit working proposal, not owner acceptance.
A = established scope meaning. Unmarked counts are unspecified.
One / optional / many symbols describe relationship ends.
endlegend
@enduml
