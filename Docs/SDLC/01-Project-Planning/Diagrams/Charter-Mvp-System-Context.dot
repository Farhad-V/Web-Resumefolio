digraph MvpContext {
 graph [bgcolor="#111827",fontcolor="#F3F4F6"];node [fontcolor="#F3F4F6"];edge [fontcolor="#CBD5E1"];

  graph [rankdir=LR, bgcolor="#111827", pad=0.35, nodesep=0.55, ranksep=0.85,
         label="MVP SYSTEM CONTEXT", labelloc=t, labeljust=l,
         fontname="Segoe UI", fontsize=23, fontcolor="#F3F4F6", dpi=150];
  node [shape=box, style="rounded,filled", fontname="Segoe UI", fontsize=14,
        fontcolor="#F3F4F6", color="#94A3B8", fillcolor="#1F2937",
        penwidth=1.4, margin="0.23,0.13"];
  edge [fontname="Segoe UI", fontsize=11, color="#94A3B8",
        fontcolor="#F3F4F6", arrowsize=0.72, penwidth=1.35];

  user [label="Invited User"];
  employer [label="Employer"];
  collaborator [label="Repository Collaborator"];
  core [label="Resumefolio Core", fillcolor="#1F2937", color="#94A3B8", penwidth=2];
  forge [label="ProjectForge", fillcolor="#1F2937", color="#94A3B8", penwidth=2];

  { rank=same; user; employer; }
  user -> core [label="Manages profiles, resumes
 and applications"];
  employer -> core [label="Views selected materials
 through a protected link"];
  core -> forge [label="Authenticated,
 user-scoped API", color="#94A3B8"];
  forge -> collaborator [dir=back, label="Works within
 repository permissions"];
}
