@startuml
!theme cyborg
skinparam backgroundColor #111827
skinparam defaultFontColor #F3F4F6
title Proposed — Protocol selection by actual boundary need
!pragma useVerticalIf on
skinparam backgroundColor #111827
skinparam shadowing false
skinparam defaultFontName Arial

start
:Identify actual consumer, operation semantics and trust boundary;
if (Same application / in-process module?) then (yes)
 :Explicit language-level contract and permitted projection;
else (no)
 if (Native Git client?) then (yes)
  :Evaluate actual Git-compatible transport and credential/ref contract;
 else (no)
  if (Browser interaction / protected retrieval?) then (yes)
   :Candidate HTTPS page / command / controlled byte delivery;
  else (no)
   if (External provider / executor / target?) then (yes)
    :Evaluate actual supported adapter/control protocol and current capability;
   else (no)
    :Document evidenced client need before choosing another transport;
   endif
  endif
 endif
endif
:Record exact schema, authority, result, concurrency and compatibility contract;
stop

@enduml