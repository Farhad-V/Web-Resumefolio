@startuml
!theme cyborg
skinparam backgroundColor #111827
skinparam defaultFontColor #F3F4F6
title Proposed / illustrative — Native Git objects and references
skinparam backgroundColor #111827
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0

rectangle "HEAD\nsymbolic reference in this example" as H
rectangle "refs/heads/main\nbranch reference, not object" as R
rectangle "commit C\nroot tree + parent identities + metadata" as C
rectangle "parent commit P\nzero/more parents in general" as P
rectangle "root tree T\nnamed entries + modes + object identities" as T
rectangle "subtree S" as S
rectangle "blob B\ncontent, not filename" as B
rectangle "refs/tags/v1\nannotated tag reference example" as TR
rectangle "tag object V\ntarget + tag metadata" as V
H --> R : symbolic target
R --> C
C --> P : parent
C --> T : snapshot
T --> S : named subtree entry
T --> B : named file entry
TR --> V
V --> C : target in this example

@enduml