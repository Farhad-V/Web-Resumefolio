@startuml
!theme cyborg
skinparam backgroundColor #111827
skinparam defaultFontColor #F3F4F6
skinparam backgroundColor #111827
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 14
skinparam shadowing false
skinparam ArrowColor #164E63
skinparam ArrowFontSize 12
skinparam rectangleBackgroundColor #164E63
skinparam rectangleBorderColor #164E63
skinparam packageBackgroundColor #164E63
skinparam packageBorderColor #164E63
skinparam componentBackgroundColor #164E63
skinparam noteBackgroundColor #164E63
skinparam noteBorderColor #164E63
skinparam nodesep 35
skinparam ranksep 45
skinparam padding 8
title HISTORICAL broader-product proposal — Scope and stakeholder map
top to bottom direction
rectangle "Resumefolio\nFull agreed Version 1 scope" as system
rectangle "Owner / applicant\nProfessional presentation\nManual applications\nMail / calendar" as owner
rectangle "Employer viewer\nSelected protected presentation\nNo product account required" as viewer
rectangle "Authorized participant\nWork / Sprints / Git\nConditional execution" as participant
rectangle "Authorized operator\nAdministration / recovery" as operator
rectangle "Excluded\nProduct AI / automatic translation\nAutomatic old-demo migration" as excluded #164E63
owner --> system : scoped goals
viewer --> system : selected disclosure only
participant --> system : resource-specific authority
operator --> system : explicit operating powers
system ..> excluded : outside agreed boundary

legend bottom
Logical analysis; relationships do not confer authority or select implementation.
endlegend
@enduml
