@startuml
!theme cyborg
skinparam backgroundColor #111827
skinparam defaultFontColor #F3F4F6
title Proposed — Essential owner and viewer intentions
skinparam backgroundColor #111827
skinparam shadowing false
skinparam defaultFontName Arial

left to right direction
actor "Authorized owner" as O
actor "Permitted viewer" as V
rectangle "Professional Presentation" {
 usecase "Maintain reusable professional source" as S
 usecase "Compose independent resume\nselections / order / layout / overrides" as D
 usecase "Preview differences and apply selected changes" as A
 usecase "Preview exact draft" as P
 usecase "Separately confirm exact publication" as C
}
rectangle "Representation / Sharing" {
 usecase "Resolve eligible page / rendition / link" as R
}
O --> S
O --> D
O --> A
O --> P
O --> C
O --> R
V --> R

@enduml