@startuml
!theme cyborg
skinparam backgroundColor #111827
skinparam defaultFontColor #F3F4F6
allowmixing
title Proposed — Applications inbound and outbound dependencies
skinparam backgroundColor #111827
skinparam shadowing false
skinparam defaultFontName Arial

component "Authorized UI / command entry" as U
component "Applications public contract" as A
component "Applications owned state" as D
component "Identity" as I
component "Presentation contract" as P
component "Files reference contract" as F
component "Communication summary contract" as C
U --> A : inbound commands / queries
A --> D : owned mutation / read
A --> I : outbound current scoped context
A --> P : outbound exact projection
A --> F : outbound protected-reference coordination
A --> C : outbound permitted association lookup

@enduml