@startuml
!theme cyborg
skinparam backgroundColor #111827
skinparam defaultFontColor #F3F4F6
title Proposed / illustrative — Logical ERD: exact publication and live selection
skinparam backgroundColor #111827
skinparam shadowing false
skinparam defaultFontName Arial

entity Resume {
 * resumeId : identity <<PK>>
 ownerId : actor identity
}
entity Draft {
 * resumeId : identity <<PK, FK Resume>>
 version : revision
 selectedContent : validated value
}
entity PublicationRevision {
 * revisionId : identity <<PK>>
 resumeId : identity <<FK Resume>>
 sourceDraftVersion : revision provenance
 confirmedContent : immutable value
}
entity LiveSelection {
 * resumeId : identity <<PK, FK Resume>>
 revisionId : identity <<same-resume FK>>
}
Resume ||--|| Draft
Resume ||--o{ PublicationRevision
Resume ||--o| LiveSelection
PublicationRevision ||--o| LiveSelection

@enduml