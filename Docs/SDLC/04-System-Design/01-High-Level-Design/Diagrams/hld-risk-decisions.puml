@startuml
!theme plain
skinparam backgroundColor #111827
skinparam defaultFontName Arial
skinparam defaultFontColor #F3F4F6
skinparam ArrowColor #CBD5E1
skinparam ArrowFontColor #CBD5E1
skinparam shadowing false
skinparam rectangle {
 BackgroundColor #1F2937
 BorderColor #94A3B8
 FontColor #F3F4F6
}
top to bottom direction
title Architecture Risk and Decision Follow-up
rectangle "Identify assumption / risk\nAffected capability and owner" as risk
rectangle "Link governing scope / ADR\nDefine evidence and hold condition" as plan
rectangle "Verify candidate and environment\nRecord observed result" as evidence
rectangle "Unmet / unresolved\nKeep affected gate open" as hold #312E81
rectangle "Choice must change\nReview alternatives and revise ADR" as revise #312E81
rectangle "Mitigation demonstrated or\nremaining exposure explicitly accepted" as resolved #164E63
rectangle "Update HLD / LLD / RTM / work item\nReopen if evidence is invalidated" as update
risk --> plan
plan --> evidence
evidence --> hold : Insufficient evidence
evidence --> revise : Selected choice no longer fits
evidence --> resolved : Supported disposition
hold --> plan : Follow-up
revise --> plan : Revised decision / checks
resolved --> update
@enduml
