@startuml
!theme cyborg
skinparam backgroundColor #111827
skinparam defaultFontColor #F3F4F6
skinparam ArrowColor #CBD5E1
skinparam backgroundColor #111827
skinparam defaultFontName Arial
skinparam defaultFontColor #164E63
skinparam ArrowColor #164E63
skinparam shadowing false
skinparam activity {
 BackgroundColor #164E63
 BorderColor #164E63
 FontColor #164E63
 DiamondBackgroundColor #164E63
 DiamondBorderColor #164E63
 DiamondFontColor #164E63
 StartColor #164E63
 EndColor #164E63
 BarColor #164E63
}
skinparam noteBackgroundColor #164E63
skinparam noteBorderColor #164E63
skinparam noteFontColor #164E63
title Candidate Promotion and Recovery Decision Flow
start
:Identify source revision, locked build,
configuration and migration set;
:Verify isolated build/test environment;
:Rehearse rollout, smoke checks,
backup restore and rollback compatibility;
if (Candidate and prerequisites approved?) then (yes)
 :Promote the same verified candidate
using the rehearsed runbook;
 :Apply reviewed rollout / migrations;
 if (Migration and data compatibility verified?) then (yes)
  :Check intended revision, health
and essential user journeys;
  if (Promotion checks pass?) then (yes)
   :Record deployed revision and evidence; 
   stop
  else (no)
   :Stop promotion / contain affected activity;
  endif
 else (no)
  :Stop promotion / contain affected activity;
 endif
 if (Code rollback safe for current data?) then (yes)
  :Restore last known good application revision;
  :Repeat health and essential smoke checks; 
 else (no)
  :Pause affected writes and preserve evidence;
  :Follow approved data recovery procedure
with isolated restore verification;
  :Verify recovered records, bytes, Git state
and compatible application revision;
 endif
 :Record incident, recovery outcome
and remaining follow-up;
 stop
else (no)
 :Record unmet gate and
do not deploy;
 stop
endif
@enduml
