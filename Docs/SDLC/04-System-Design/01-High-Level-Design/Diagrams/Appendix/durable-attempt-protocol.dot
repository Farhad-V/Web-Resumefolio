digraph G {
 graph [bgcolor="#111827",fontcolor="#F3F4F6"]; node [fontcolor="#F3F4F6"]; edge [fontcolor="#CBD5E1"];
rankdir=TB;graph [bgcolor="#111827",pad="0.3",nodesep="0.35",ranksep="0.55",fontname="Arial"];node [shape=box,style="rounded,filled",fillcolor="#1F2937",color="#94A3B8",fontname="Arial",fontsize=12,margin="0.17,0.12"];edge [fontname="Arial",fontsize=10,color="#94A3B8"];
command [label="Validated command + stable identity
Current authority and expected version"];
commit [label="Short local transaction
Mutation + durable pending intent",fillcolor="#1F2937"];
claim [label="Claim attempt with lease + fencing token
Duplicate delivery is possible"];
effect [label="Dispatch exact reviewed external intent",fillcolor="#1F2937"];
known [shape=diamond,label="Effect supported by
actual evidence?"];
record [label="Record confirmed / partial outcome
Validate current claim token",fillcolor="#1F2937"];
unknown [label="Retain UNKNOWN / pending observation
Reconcile same attempt before consequential repeat",fillcolor="#1F2937"];
command->commit->claim->effect->known;known->record [label="yes"];known->unknown [label="no / lost response"];
note [label="Lease expiry does not stop an old network action
Local fencing cannot guarantee exactly-once remote effects",shape=note,fillcolor="#1F2937"];unknown->note [arrowhead=none,style=dashed];
}