@startuml
!theme cyborg
skinparam backgroundColor #111827
skinparam defaultFontColor #F3F4F6
skinparam ArrowColor #CBD5E1
title Proposed processes, execution contexts and durable work
skinparam backgroundColor #111827
skinparam shadowing false
skinparam defaultFontName Arial

rectangle "Interactive requests" as U
node "Trusted web runtime" {
 rectangle "Bounded request-process workers\nLaravel-compatible runtime; arrangement pending" as WEB
 rectangle "Per-operation scoped actor / handler state\nNo assumed shared mutable user singleton" as CTX
 WEB --> CTX
}
database "Owned transactional state / pending work" as DB
rectangle "Dispatcher / scheduler responsibility\nActual supervisor / overlap guards pending" as D
node "Bounded background runtime" {
 rectangle "Job worker processes\nPer-attempt current context / claim" as W
}
rectangle "Evaluated isolated executor\nSeparate trust/resource gate" as E
U --> WEB
CTX --> DB : short guarded command
D --> DB : due work / claims
D --> W : eligible identity
W --> DB : claim / observation
W --> E : only admitted exact jobs
legend bottom
 Logical roles may share compatible code; they are not one server or thread each.
 Proposed process concurrency does not adopt a language thread pool, event loop or actor framework.
 Thread counts, process limits and actual runtime facilities remain compatibility/capacity work.
endlegend
@enduml
