digraph G {
 graph [bgcolor="#111827",fontcolor="#F3F4F6"]; node [fontcolor="#F3F4F6"]; edge [fontcolor="#CBD5E1"];
rankdir=TB;graph [bgcolor="#111827",pad="0.3",nodesep="0.35",ranksep="0.55",fontname="Arial"];node [shape=box,style="rounded,filled",fillcolor="#1F2937",color="#94A3B8",fontname="Arial",fontsize=12,margin="0.17,0.12"];edge [fontname="Arial",fontsize=10,color="#94A3B8"];
request [label="Record cancellation intent
Exact attempt + current authority"];
admitted [shape=diamond,label="Dispatch atomically
prevented?"];
cancel [label="Confirmed cancelled before dispatch",fillcolor="#1F2937"];
stop [label="Request stop through evaluated adapter
Cancellation remains pending",fillcolor="#1F2937"];
result [shape=diamond,label="Actual termination /
completion observed?"];
actual [label="Record actual stopped or completed result
Preserve known partial / target effects",fillcolor="#1F2937"];
unknown [label="Runner lost / stop acknowledgment absent
Reconcile same attempt; do not blindly relaunch",fillcolor="#1F2937"];
request->admitted;admitted->cancel [label="yes"];admitted->stop [label="no / running"];stop->result;result->actual [label="yes"];result->unknown [label="no"];
}