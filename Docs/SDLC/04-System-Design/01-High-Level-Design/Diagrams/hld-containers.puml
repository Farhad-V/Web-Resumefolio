@startuml
!theme plain
skinparam backgroundColor #111827
skinparam defaultFontName Arial
skinparam defaultFontColor #F3F4F6
skinparam ArrowColor #CBD5E1
skinparam ArrowFontColor #CBD5E1
skinparam shadowing false
skinparam roundcorner 12
skinparam componentStyle rectangle
skinparam rectangle {
 BackgroundColor #1F2937
 BorderColor #64748B
 FontColor #F3F4F6
}
skinparam database {
 BackgroundColor #1F2937
 BorderColor #64748B
 FontColor #F3F4F6
}
skinparam actor {
 BackgroundColor #1F2937
 BorderColor #CBD5E1
 FontColor #F3F4F6
}
skinparam package {
 BackgroundColor #111827
 BorderColor #67E8F9
 FontColor #67E8F9
}
skinparam node {
 BackgroundColor #111827
 BorderColor #64748B
 FontColor #F3F4F6
}
left to right direction
title Application Structure and Data Ownership
rectangle "Browser\nReact + Inertia pages" as browser
package "Core application boundary" {
 rectangle "Laravel Core\nIdentity and access\nPresentation and sharing\nApplications and files" as core #164E63
 database "Core MySQL\nOwned records" as cdb
 rectangle "Core private filesystem\nMedia, PDF and retained artifacts" as files
 rectangle "Core background worker\nDurable jobs / outbox" as worker
 core --> cdb
 core --> files
 core --> worker : Durable work
 worker --> cdb
 worker --> files
}
package "ProjectForge application boundary" #111827 {
 rectangle "Laravel ProjectForge\nAPI / Git authorization\nIssues and Kanban" as forge #312E81
 database "ProjectForge MySQL\nGrants, issues and metadata" as fdb
 rectangle "Private repository filesystem\nNative Git objects" as repos
 forge --> fdb
 forge --> repos
}
browser --> core : HTTPS / session
core --> forge : Scoped API
forge --> core : Entitlement check
@enduml
