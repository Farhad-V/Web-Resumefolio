// OWNER-MVP-2026-11-04 review: Method / document navigation. Scope-independent process/navigation; provider or runner examples are not MVP prerequisites.
digraph templates {
 graph [fontcolor="#F1F5F9"];
 edge [fontcolor="#F1F5F9"];
 graph [rankdir=TB,bgcolor="#101827",pad=0.3,nodesep=0.45,ranksep=0.65,fontname="Arial",fontsize=21,label="Resumefolio | Reusable record relationships",labelloc=t];
 node [shape=box,style="rounded,filled",fillcolor="#1C3453",color="#9FB2CD",fontcolor="#F1F5F9",fontname="Arial",fontsize=14,margin="0.18,0.14"];
 edge [color="#9FB2CD",fontname="Arial",fontsize=12,fontcolor="#F1F5F9"];
 source [label="Actual source and actor context
Accepted boundary vs proposed detail"];
 story [label="Story
Actor + desired outcome + intended value",fillcolor="#382951"];
 req [label="Primary requirement
Obligation + source + exact criteria
Access / data / quality / lifecycle"];
 scenario [label="Scenario
One path + conditions + steps
Expected observable resulting state"];
 gaps [label="Open question / dependency
Owner + next action + gate
No invented policy or target",fillcolor="#49351C"];
 evidence [label="Separate actual review / execution evidence
Identified revision / environment / method
Actual result + limitations",fillcolor="#173B34"];
 decision [label="Actual owner disposition
Not inferred from a filled template",fillcolor="#382951"];
 source -> story; source -> req;
 story -> req [label="link primary detail"];
 req -> scenario [label="criteria / rules"];
 gaps -> req [label="resolve affected blocker",style=dashed];
 scenario -> evidence [label="later authorized checks"];
 req -> evidence [label="inspection / analysis / other method"];
 evidence -> decision;
}
