// OWNER-MVP-2026-11-04 review: Method / document navigation. Scope-independent process/navigation; provider or runner examples are not MVP prerequisites.
digraph model {
 graph [fontcolor="#F1F5F9"];
 edge [fontcolor="#F1F5F9"];
graph [rankdir=TB,bgcolor="#101827",pad=0.3,nodesep=0.45,ranksep=0.65,fontname="Arial",fontsize=21,labelloc=t];
node [shape=box,style="rounded,filled",fillcolor="#1C3453",color="#9FB2CD",fontcolor="#F1F5F9",fontname="Arial",fontsize=14,margin="0.18,0.14"];
edge [color="#9FB2CD",fontname="Arial",fontsize=12,fontcolor="#F1F5F9"];
graph [label="Resumefolio | Evidence states in the traceability chain"];
source [label="Accepted scope / objectives
Source authority retains its limits"];
candidate [label="Primary proposed records
157 candidates + source / criteria / method"];
scenario [label="Explicit candidate-to-bundle citations
123 candidates cited / 34 uncited
Specific criterion-path mapping pending",fillcolor="#49351C"];
inspect [label="Actual RV-D01 evidence
Source hashes + inventory
Bounded structure / citation findings",fillcolor="#173B34"];
down [label="Exact PBI / design / code / product-result links
Not assigned per candidate here",fillcolor="#49351C"];
owner [label="Actual semantic / owner / product decisions
Pending or separate later evidence",fillcolor="#382951"];
source -> candidate;
candidate -> scenario [label="observed citations only"];
candidate -> inspect [label="inspected structure"];
scenario -> inspect [label="observed path references"];
candidate -> down [style=dashed,label="verify actual artifacts later"];
inspect -> owner [label="does not equal approval"];
down -> owner [style=dashed,label="actual evidence needed"];
}
