digraph model {
 graph [fontcolor="#F1F5F9"];
 edge [fontcolor="#F1F5F9"];
graph [rankdir=TB,bgcolor="#101827",pad=0.3,nodesep=0.45,ranksep=0.65,fontname="Arial",fontsize=21,labelloc=t];
node [shape=box,style="rounded,filled",fillcolor="#1C3453",color="#9FB2CD",fontcolor="#F1F5F9",fontname="Arial",fontsize=14,margin="0.18,0.14"];
edge [color="#9FB2CD",fontname="Arial",fontsize=12,fontcolor="#F1F5F9"];
graph [label="Resumefolio | Validation and traceability review route"];
source [label="Accepted intent + actual primary records
Identify source / revision / actor context"];
inspect [label="RV-D01: actual documentary inspection
157 candidates / 470 criterion bullets
12 bundles / 60 path drafts",fillcolor="#173B34"];
cites [label="Observed explicit citations
123 cited / 34 not explicitly cited
Not criterion-level sufficiency",fillcolor="#49351C"];
review [label="Pending semantic and actor / owner review
