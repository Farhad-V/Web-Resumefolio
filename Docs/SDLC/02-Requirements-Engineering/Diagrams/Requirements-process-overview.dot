// OWNER-MVP-2026-11-04 review: Method / document navigation. Scope-independent process/navigation; provider or runner examples are not MVP prerequisites.
digraph ProcessOverview {
 graph [fontcolor="#F1F5F9"];
 edge [fontcolor="#F1F5F9"];
 graph [rankdir=TB,bgcolor="#101827",pad=0.35,ranksep=0.45,nodesep=0.4,fontname="Arial",fontsize=21,labelloc=t,
 label="Resumefolio | Requirements process and approach\nIterative work with feasibility input and management throughout"];
 node [shape=box,style="rounded,filled",fontname="Arial",fontsize=14,color="#9FB2CD",fontcolor="#F1F5F9",margin="0.22,0.16",fillcolor="#1C3453"];
 edge [color="#9FB2CD",arrowsize=0.7,fontname="Arial",fontsize=12];
 approach [label="01 | APPROACH\nMethod, rationale and review gates",fillcolor="#31577D",fontcolor=white];
 feasibility [label="02 | FEASIBILITY\nInvestigate decisive constraints early\nReassess when conditions change",fillcolor="#49351C"];
 elicit [label="03 | ELICITATION\nSources, actor goals and context"];
 analyze [label="04 | ANALYSIS AND NEGOTIATION\nClarify, classify and resolve trade-offs"];
 specify [label="05 | SPECIFICATION\nPrecise records, criteria and supporting views"];
 review [label="06 | VERIFICATION AND VALIDATION\nSpecification quality and intended use\nFindings can restart earlier activities",fillcolor="#49351C"];
 manage [label="07 | MANAGEMENT THROUGHOUT\nIdentity, states and traceability\nChange, revisions and actual decisions",fillcolor="#382951"];
 approach -> elicit;
 approach -> feasibility;
 elicit -> analyze -> specify -> review;
 feasibility -> analyze [style=dashed,label="relevant evidence"];
 manage:w -> elicit:e [style=dashed,constraint=false];
 manage:w -> specify:e [style=dashed,constraint=false];
 manage:s -> review:e [style=dashed,constraint=false];
 {rank=same;approach;feasibility;}
 {rank=same;analyze;manage;}
}
