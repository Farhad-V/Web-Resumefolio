// OWNER-MVP-2026-11-04 review: Mixed MVP / future. Retained broader-product associations require explicit future node labels; MVP uses only core/basic ProjectForge.
digraph terms {
 graph [fontcolor="#F1F5F9"];
 edge [fontcolor="#F1F5F9"];
 graph [label="MVP + EXPLICIT FUTURE PATHS | data terminology boundaries",labelloc=t];
 graph [rankdir=LR,bgcolor="#101827",pad=0.3,nodesep=0.45,ranksep=0.7,fontname="Arial",fontsize=21,label="Resumefolio | Keep overloaded meanings distinct",labelloc=t];
 node [shape=box,style="rounded,filled",fillcolor="#1C3453",color="#9FB2CD",fontcolor="#F1F5F9",fontname="Arial",fontsize=14,margin="0.18,0.14"];
 edge [color="#9FB2CD",fontname="Arial",fontsize=12,fontcolor="#F1F5F9",dir=none];
 source [label="Editable source / current rendition"];
 hist [label="Actual submitted set
Later source edits do not overwrite",fillcolor="#173B34"];
 auth [label="Authentication / membership"];
 grant [label="Resource + action authorization
No unrelated private grant",fillcolor="#382951"];
 task [label="Task / card position"];
 accepted [label="Item acceptance / Sprint outcome
Explicit conditions, goal + items + plan",fillcolor="#382951"];
 provider [label="Provider acceptance / unknown response"];
 delivered [label="Delivery / read confirmation
Only evidence-supported claims",fillcolor="#49351C"];
 backup [label="Backup material / recovery point"];
 restore [label="Demonstrated usable recovery
Integrity + safe restored access + targets",fillcolor="#173B34"];
 source -> hist [label="distinct"];
 auth -> grant [label="distinct"];
 task -> accepted [label="distinct"];
 provider -> delivered [label="distinct"];
 backup -> restore [label="distinct"];
 {rank=same;source;auth;task;provider;backup;}
 {rank=same;hist;grant;accepted;delivered;restore;}
}
