// OWNER-MVP-2026-11-04 review: Method / document navigation. Scope-independent process/navigation; provider or runner examples are not MVP prerequisites.
digraph RequirementsRoadmap {
 graph [fontcolor="#F1F5F9"];
 edge [fontcolor="#F1F5F9"];
  graph [rankdir=TB, bgcolor="#101827", pad=0.35, ranksep=0.40, nodesep=0.30,
    fontname="Arial", fontsize=21, labelloc=t,
    label="Resumefolio | Requirements roadmap\nOutcome prerequisites - no dates or duration estimates"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=14,
    color="#9FB2CD", fontcolor="#F1F5F9", margin="0.22,0.16", fillcolor="#1C3453"];
  edge [color="#9FB2CD", arrowsize=0.7, fontname="Arial", fontsize=12];
  planning [label="M-01 | PLANNING STARTING POINT\nRecorded acceptance under DEC-116\nGAP-D01 through GAP-D11 remain tracked", fillcolor="#173B34"];
  develop [label="DEVELOP COHERENT REQUIREMENT GROUPS\nCapture sources and actor goals\nAnalyze behavior, rules, data and dependencies"];
  refine [label="SPECIFY AND REFINE\nAcceptance criteria and planned verification\nScenarios, models and traceability"];
  review [shape=diamond, style=filled, label="M-02 REVIEW\nCoverage, consistency, testability\nand blocking ambiguity", fillcolor="#49351C", fontsize=12];
  baseline [label="M-02 | REQUIREMENTS BASELINE\nActual owner decision against an identified revision\nAcceptance pending", fillcolor="#49351C"];
  design [label="M-03 | FEASIBILITY AND DESIGN\nJustified analysis, design and relevant findings\nSubsequent work", fillcolor="#382951"];
  gate [label="EXISTING PRE-IMPLEMENTATION GATE\nInitial documentation for all agreed SDLC phases\nReconciled backlog / Sprints / milestones\nBaseline agreement before product coding", fillcolor="#382951"];
  evidence [label="INVESTIGATE EARLY\nServer, Google, email delivery\nRecovery and CI/CD isolation\nBefore dependent commitments", fillcolor="#3C3020"];
  planning -> develop -> refine -> review;
  review -> develop [label="refine if needed", style=dashed, color="#F2BA72", constraint=false];
  review -> baseline [label="criteria met + owner accepts"];
  baseline -> design -> gate;
  evidence -> develop [style=dashed, label="relevant findings"];
  evidence -> design [style=dashed, label="relevant findings"];
  {rank=same; evidence; refine;}
}
