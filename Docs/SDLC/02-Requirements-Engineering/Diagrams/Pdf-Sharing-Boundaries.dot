// OWNER-MVP-2026-11-04 review: MVP core / cross-cutting. Core presentation/application/files or shared authority/recovery invariant remains applicable.
digraph model {
 graph [fontcolor="#F1F5F9"];
 edge [fontcolor="#F1F5F9"];
graph [bgcolor="#101827",pad=0.3,nodesep=0.45,ranksep=0.75,fontname="Arial",fontsize=21,labelloc=t];
node [shape=box,style="rounded,filled",fillcolor="#1C3453",color="#9FB2CD",fontcolor="#F1F5F9",fontname="Arial",fontsize=14,margin="0.18,0.14"];
edge [color="#9FB2CD",fontname="Arial",fontsize=12,fontcolor="#F1F5F9"];
graph [rankdir=LR,label="Resumefolio | PDF, sharing and copy boundaries"];
authored [label="Authored resume
Defined content / revision"];
generated [label="Generated PDF
Defined rendition / revision"];
uploaded [label="Uploaded PDFs
Separate English / German variants"];
shared [label="Controlled employer context
Password + selected content
Per-resume download availability",fillcolor="#382951"];
downloaded [label="Legitimately downloaded copy
Cannot be recalled by disabling link",fillcolor="#49351C"];
history [label="Preserved actual submitted copy
Separate application-history policy",fillcolor="#173B34"];
authored -> generated [label="defined generation"];
generated -> shared [label="if enabled / authorized"];
uploaded -> shared [label="enabled language / variant"];
shared -> downloaded [label="authorized retrieval"];
generated -> history [style=dashed,label="only if actually submitted / captured"];
uploaded -> history [style=dashed,label="only if actually submitted / captured"];
}
