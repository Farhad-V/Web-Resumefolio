digraph model {
 graph [fontcolor="#F1F5F9"];
 edge [fontcolor="#F1F5F9"];
graph [rankdir=TB,bgcolor="#101827",pad=0.3,nodesep=0.45,ranksep=0.65,fontname="Arial",fontsize=21,labelloc=t];
node [shape=box,style="rounded,filled",fillcolor="#1C3453",color="#9FB2CD",fontcolor="#F1F5F9",fontname="Arial",fontsize=14,margin="0.18,0.14"];
edge [color="#9FB2CD",fontname="Arial",fontsize=12,fontcolor="#F1F5F9"];
graph [label="Resumefolio | Open question groups and gates"];
root [label="Q-D01-Q-D28: all open
Farhad coordinates actual answers / findings",fillcolor="#382951"];
core [label="Q01-Q14: records / actors / access
Professional content / PDF / sharing
Applications / actual submitted history"];
connected [label="Q15-Q22: provider + collaboration
Mail / calendar / work / Sprints
Real Git contracts and review"];
ops [label="Q23-Q28: execution / effective policy
Quality / backup / restored access
Operation / applicability / forecast",fillcolor="#49351C"];
gate [label="Dependent acceptance / evidence gates
Define affected behavior in M-02
Actual findings before dependent design / enabling
