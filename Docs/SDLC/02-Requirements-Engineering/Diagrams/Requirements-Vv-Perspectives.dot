// OWNER-MVP-2026-11-04 review: Method / document navigation. Scope-independent process/navigation; provider or runner examples are not MVP prerequisites.
digraph RequirementsVV {
 graph [fontcolor="#F1F5F9"];
 edge [fontcolor="#F1F5F9"];
 graph [rankdir=TB,bgcolor="#101827",pad=0.35,ranksep=0.5,nodesep=0.45,fontname="Arial",fontsize=21,labelloc=t,
 label="Resumefolio | Requirements verification and validation\nComplementary review perspectives - actual evidence defines the conclusion"];
 node [shape=box,style="rounded,filled",fontname="Arial",fontsize=14,color="#9FB2CD",fontcolor="#F1F5F9",margin="0.22,0.16",fillcolor="#1C3453"];
 edge [color="#9FB2CD",arrowsize=0.7,fontname="Arial",fontsize=12];
 input [label="IDENTIFIED REQUIREMENT GROUP\nSources, scope, criteria, scenarios, models and data definitions",fillcolor="#31577D",fontcolor=white];
 verify [label="VERIFY REQUIREMENT QUALITY\nClear, consistent, traceable and assessable\nRelevant paths, constraints and dependencies"];
 validate [label="VALIDATE INTENDED USE\nActor goals and realistic workflows\nActual feedback, context and missing perspectives",fillcolor="#382951"];
 finding [label="ACTUAL FINDINGS AND RECHECKS\nRevision + method + reviewer / date + evidence\nCorrections, decisions, limits and remaining blockers",fillcolor="#49351C"];
 gate [label="READINESS / BASELINE ASSESSMENT\nSeparate criteria and actual owner decision\nM-02 acceptance remains pending",fillcolor="#49351C"];
 later [label="LATER PRODUCT EVIDENCE\nImplemented candidate + environment\nExecuted checks and expected / actual results\nNot established by requirements review",fillcolor="#173B34"];
 input -> verify;input -> validate;
 verify -> finding;validate -> finding;
 finding -> gate;
 gate -> later [style=dashed,label="later engineering and verification"];
 {rank=same;verify;validate;}
}
