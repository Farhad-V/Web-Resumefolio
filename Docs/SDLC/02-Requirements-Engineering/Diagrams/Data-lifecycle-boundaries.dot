// OWNER-MVP-2026-11-04 review: MVP core / cross-cutting. Core presentation/application/files or shared authority/recovery invariant remains applicable.
digraph lifecycle {
 graph [fontcolor="#F1F5F9"];
 edge [fontcolor="#F1F5F9"];
 graph [rankdir=LR, bgcolor="#101827", pad=0.3, nodesep=0.5, ranksep=0.7, fontname="Arial", fontsize=21, label="Resumefolio | Data lifecycle boundaries", labelloc=t];
 node [shape=box, style="rounded,filled", fillcolor="#1C3453", color="#9FB2CD", fontcolor="#F1F5F9", fontname="Arial", fontsize=14, margin="0.18,0.14"];
 edge [color="#9FB2CD", fontname="Arial", fontsize=12, fontcolor="#F1F5F9"];
 profile [label="Editable professional profile
Shared information"];
 resume [label="Tailored resume
Independent selection / overrides"];
 evidence [label="Evidence and PDF variants
Explicit selection / availability"];
 live [label="Controlled live employer view
Only authorized selected content",fillcolor="#382951"];
 history [label="Preserved actual submitted materials
Resume + cover letter
Not overwritten by later source edits",fillcolor="#173B34"];
 policy [label="Explicit lifecycle policies
References / retention / recovery
Details pending owner review",fillcolor="#49351C"];
 profile -> resume [label="explicit preview / select / apply"];
 resume -> live [label="separately confirmed publication"];
 evidence -> live [label="authorized retrieval"];
 resume -> history [label="defined capture of actual materials"];
 history -> policy [label="retirement governed by",style=dashed];
 evidence -> policy [label="reference-aware removal",style=dashed];
 live -> policy [label="access change rules",style=dashed];
}
