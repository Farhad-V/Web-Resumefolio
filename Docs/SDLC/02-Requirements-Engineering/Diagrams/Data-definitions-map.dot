// OWNER-MVP-2026-11-04 review: Mixed MVP / future. Retained broader-product associations require explicit future node labels; MVP uses only core/basic ProjectForge.
digraph DataDefinitions {
 graph [fontcolor="#F1F5F9"];
 edge [fontcolor="#F1F5F9"];
 graph [label="MVP + EXPLICIT FUTURE PATHS | data definitions map",labelloc=t];
 graph [rankdir=TB,bgcolor="#101827",pad=0.35,ranksep=0.5,nodesep=0.4,fontname="Arial",fontsize=21,labelloc=t,
 label="Resumefolio | Conceptual information map\nWorking definitions - not a database schema or permission model"];
 node [shape=box,style="rounded,filled",fontname="Arial",fontsize=14,color="#9FB2CD",fontcolor="#F1F5F9",margin="0.22,0.16",fillcolor="#1C3453"];
 edge [color="#9FB2CD",arrowsize=0.7,fontname="Arial",fontsize=12];
 account [label="ACCOUNT / RESOURCE CONTEXT\nOwnership and permitted operations\nDetailed draft policies await review",fillcolor="#31577D",fontcolor=white];
 profile [label="PROFESSIONAL PRESENTATION\nProfile + tailored resume + selected evidence\nGenerated / uploaded PDFs + sharing"];
 application [label="MANUAL APPLICATIONS\nCompany / opportunity + cover letter\nApplication record and progress",fillcolor="#49351C"];
 communications [label="COMMUNICATION / SCHEDULING\nProvider connections + email\nCalendar activities + reminders",fillcolor="#49351C"];
 work [label="WORK AND CODE COLLABORATION\nProjects / boards / backlogs / Sprints / tasks\nRepositories / reviews / releases / workflows",fillcolor="#382951"];
 submitted [label="PRESERVED SUBMITTED MATERIALS\nWhat was actually submitted\nLater source edits do not overwrite copies",fillcolor="#173B34"];
 operations [label="OPERATIONAL INFORMATION\nFile policy + relevant audit information\nRun outputs + backup / recovery records",fillcolor="#2C394F"];
 account -> profile [label="owner / access context"];
 account -> application [label="owner / access context"];
 account -> work [label="owner / member context"];
 application -> communications [label="related communications / dates"];
 profile -> application [label="selected resume"];
 application -> submitted [label="preserves submitted materials"];
 profile -> submitted [label="submitted content under explicit capture rules",style=dashed];
 work -> operations [label="execution / operational context",style=dashed];
 {rank=same;profile;application;work;}
 {rank=same;submitted;communications;operations;}
}
