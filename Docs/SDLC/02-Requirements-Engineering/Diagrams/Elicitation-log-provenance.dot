// OWNER-MVP-2026-11-04 review: Method / document navigation. Scope-independent process/navigation; provider or runner examples are not MVP prerequisites.
digraph ElicitationLog {
 graph [fontcolor="#F1F5F9"];
 edge [fontcolor="#F1F5F9"];
 graph [rankdir=TB,bgcolor="#101827",pad=0.35,ranksep=0.45,nodesep=0.4,fontname="Arial",fontsize=21,labelloc=t,
 label="Resumefolio | Elicitation record provenance\nSource acceptance is distinct from interpretation and requirement acceptance"];
 node [shape=box,style="rounded,filled",fontname="Arial",fontsize=14,color="#9FB2CD",fontcolor="#F1F5F9",margin="0.22,0.16",fillcolor="#1C3453"];
 edge [color="#9FB2CD",arrowsize=0.7,fontname="Arial",fontsize=12];
 source [label="SOURCE REGISTER\nSRC reference + exact section / version\nOriginal authority and limits",fillcolor="#31577D",fontcolor=white];
 activity [label="ACTUAL ACTIVITY\nLOG reference + actual date + method\nRecorder / participants or inspected material"];
 extract [label="SOURCE EXTRACT\nEXT reference + context\nLabeled paraphrase / quotation / observation"];
 interpretation [label="SEPARATE INTERPRETATION\nMeaning, assumptions and candidate needs\nActual review state",fillcolor="#49351C"];
 questions [label="OPEN DETAIL / CONFLICT\nSource links + owner + next action\nDependent review gate",fillcolor="#3C3020"];
 handoff [label="REVIEWED HANDOFF\nAnalysis / specification / scenarios\nLink real records as allocated",fillcolor="#173B34"];
 source -> activity -> extract -> interpretation;
 interpretation -> questions [label="if unresolved",style=dashed];
 interpretation -> handoff [label="actual feedback and reviewed scope"];
 questions -> handoff [style=dashed,label="unresolved gaps remain explicit"];
 {rank=same;interpretation;questions;}
}
