// OWNER-MVP-2026-11-04 review: Method / document navigation. Scope-independent process/navigation; provider or runner examples are not MVP prerequisites.
digraph model {
 graph [fontcolor="#F1F5F9"];
 edge [fontcolor="#F1F5F9"];
graph [rankdir=TB,bgcolor="#101827",pad=0.3,nodesep=0.4,ranksep=0.65,fontname="Arial",fontsize=21,labelloc=t];
node [shape=box,style="rounded,filled",fillcolor="#1C3453",color="#9FB2CD",fontcolor="#F1F5F9",fontname="Arial",fontsize=14,margin="0.18,0.14"];
edge [color="#9FB2CD",fontname="Arial",fontsize=12,fontcolor="#F1F5F9"];
graph [label="Resumefolio | Stories, use cases and scenario paths"];
source [label="Sourced actor outcome
USR-D + accepted scope"];
story [label="ST-D: user value
As actor, want outcome, so that benefit",fillcolor="#382951"];
uc [label="UC-D: goal bundle
Trigger + preconditions + boundary
Detailed criteria / open decisions"];
n [label="N: normal
Steps + success state",fillcolor="#173B34"];
a [label="A: alternative
Changed valid condition"];
d [label="D: denied
No prohibited effect / disclosure",fillcolor="#49351C"];
f [label="F: failure
Truthful partial / failed outcome",fillcolor="#49351C"];
r [label="R: recovery / correction
Explicit reconciliation policy"];
evidence [label="Separate later review / execution evidence
Path drafts do not establish Pass results",fillcolor="#382951"];
source -> story; story -> uc;
uc -> n; uc -> a; uc -> d; uc -> f; uc -> r;
n -> evidence; a -> evidence; d -> evidence; f -> evidence; r -> evidence;
}
