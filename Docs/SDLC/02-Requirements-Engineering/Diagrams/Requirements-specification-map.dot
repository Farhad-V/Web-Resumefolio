// OWNER-MVP-2026-11-04 review: Method / document navigation. Scope-independent process/navigation; provider or runner examples are not MVP prerequisites.
digraph SpecificationMap {
 graph [fontcolor="#F1F5F9"];
 edge [fontcolor="#F1F5F9"];
 graph [rankdir=TB,bgcolor="#101827",pad=0.35,ranksep=0.45,nodesep=0.4,fontname="Arial",fontsize=21,labelloc=t,
 label="Resumefolio | Distributed requirements specification\nDocument relationships - not software architecture"];
 node [shape=box,style="rounded,filled",fontname="Arial",fontsize=14,color="#9FB2CD",fontcolor="#F1F5F9",margin="0.22,0.16",fillcolor="#1C3453"];
 edge [color="#9FB2CD",arrowsize=0.7,fontname="Arial",fontsize=12];
 srs [label="SRS ENTRY POINT\nPurpose, boundary, authority and navigation",fillcolor="#31577D",fontcolor=white];
 goals [label="BUSINESS AND USER NEEDS\nOutcomes, actor goals and rationale"];
 domains [label="DOMAIN REQUIREMENTS\nRequired product behavior\nOne primary record per obligation"];
 cross [label="CROSS-CUTTING REQUIREMENTS\nQuality, interfaces, constraints\nBusiness rules and lifecycle"];
 views [label="SUPPORTING VIEWS\nStories, use cases, scenarios and models\nGlossary, dictionary and permissions",fillcolor="#382951"];
 records [label="EACH REQUIREMENT RECORD\nSource + behavior + status + dependencies\nCriteria + planned verification + links"];
 review [label="TRACEABILITY AND REVIEW\nCoverage, findings and unresolved blockers\nIdentified revision",fillcolor="#49351C"];
 baseline [label="M-02 BASELINE DECISION\nActual owner acceptance against reviewed criteria\nAcceptance remains pending",fillcolor="#173B34"];
 srs -> goals;srs -> domains;srs -> cross;
 goals -> records [label="rationale / derivation"];
 domains -> records;cross -> records;
 records -> review;
 views -> review [label="consistent linked views"];
 review -> baseline [label="criteria met + actual decision"];
 {rank=same;goals;domains;cross;}
 {rank=same;records;views;}
}
