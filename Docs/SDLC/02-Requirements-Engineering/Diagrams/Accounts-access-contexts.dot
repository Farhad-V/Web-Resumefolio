// OWNER-MVP-2026-11-04 review: MVP core / cross-cutting. Core presentation/application/files or shared authority/recovery invariant remains applicable.
digraph AccountContexts {
 graph [fontcolor="#F1F5F9"];
 edge [fontcolor="#F1F5F9"];
 graph [rankdir=TB,bgcolor="#101827",pad=0.35,ranksep=0.5,nodesep=0.4,fontname="Arial",fontsize=21,labelloc=t,
 label="Resumefolio | Identity and access contexts\nConceptual boundaries - exact authentication and role policies remain proposed"];
 node [shape=box,style="rounded,filled",fontname="Arial",fontsize=14,color="#9FB2CD",fontcolor="#F1F5F9",margin="0.22,0.16",fillcolor="#1C3453"];
 edge [color="#9FB2CD",arrowsize=0.7,fontname="Arial",fontsize=12];
 account [label="OWNER/ADMIN CREATED OR INVITED ACCOUNT\nValid authentication context\nUnified sign-in to authorized sections",fillcolor="#31577D",fontcolor=white];
 private [label="OWN / AUTHORIZED PRIVATE RESOURCES\nProfiles, resumes, applications, private files/media\nResource/action checks still apply"];
 member [label="COLLABORATION CONTEXT\nSpecific project / board / repository\nOnly defined granted actions",fillcolor="#382951"];
 admin [label="ADMINISTRATIVE CONTEXT\nExplicit role/resource/action powers\nNo implied private-data authority",fillcolor="#49351C"];
 employer [label="EMPLOYER VIEWER\nNo registered account required\nEligible link + correct password",fillcolor="#173B34"];
 shared [label="SELECTED SHARED CONTENT\nIntended resume / evidence\nOnly permitted files and PDF downloads",fillcolor="#173B34"];
 guard [label="BOUNDARY FOR EACH PROTECTED REQUEST\nIdentity / grant / resource / action / current state\nNo UI-only checks or universal authority",fillcolor="#2C394F"];
 account -> private [label="authorized private work"];
 account -> member [label="only if granted"];
 account -> admin [label="only if explicitly granted"];
 employer -> shared [label="limited sharing authorization"];
 private -> guard;member -> guard;admin -> guard;shared -> guard;
 {rank=same;account;employer;}
 {rank=same;private;member;admin;shared;}
}
