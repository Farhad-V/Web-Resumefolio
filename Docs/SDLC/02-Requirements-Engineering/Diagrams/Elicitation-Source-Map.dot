// OWNER-MVP-2026-11-04 review: Method / document navigation. Scope-independent process/navigation; provider or runner examples are not MVP prerequisites.
digraph ElicitationSources {
 graph [fontcolor="#F1F5F9"];
 edge [fontcolor="#F1F5F9"];
 graph [rankdir=TB,bgcolor="#101827",pad=0.35,ranksep=0.45,nodesep=0.35,
 fontname="Arial",fontsize=21,labelloc=t,label="Resumefolio | From sources to reviewed needs\nInformation provenance - not automatic requirement acceptance"];
 node [shape=box,style="rounded,filled",fontname="Arial",fontsize=14,color="#9FB2CD",fontcolor="#F1F5F9",margin="0.22,0.16",fillcolor="#1C3453"];
 edge [color="#9FB2CD",arrowsize=0.7,fontname="Arial",fontsize=12];
 planning [label="ACCEPTED PLANNING\nObjectives, Scope and DEC records\nReuse existing decisions"];
 discussion [label="DISCUSSIONS AND WALKTHROUGHS\nActual participants, context and feedback\nSeparate raw need from interpretation"];
 references [label="DOCUMENTS AND OBSERVATIONS\nExact source, version and date\nRecord applicability and limitations"];
 log [label="SOURCE REGISTER AND ELICITATION LOG\nRaw need / observation + provenance\nMethod, rationale and actual activity details",fillcolor="#31577D",fontcolor=white];
 review [label="CLARIFY AND REVIEW\nActor goal, behavior, failures and data rules\nDistinguish interpretation from decision",fillcolor="#49351C"];
 questions [label="OPEN QUESTIONS / CONFLICTS\nMissing evidence or perspectives\nOwner, next action and dependent gate",fillcolor="#3C3020"];
 handoff [label="REVIEWED HANDOFF\nAnalysis and candidate specification\nLink scenarios, requirements and traceability",fillcolor="#173B34"];
 planning -> log;discussion -> log;references -> log;
 log -> review;review -> handoff;
 review -> questions [label="if unresolved",style=dashed];
 questions -> review [label="clarification",style=dashed,constraint=false];
 {rank=same;planning;discussion;references;}
 {rank=same;review;questions;}
}
