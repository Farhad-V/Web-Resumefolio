// OWNER-MVP-2026-11-04 review: Future after MVP. Provider, advanced Sprint/review, or untrusted execution requirement retained as deferred.
digraph work {
 graph [fontcolor="#F1F5F9"];
 edge [fontcolor="#F1F5F9"];
 graph [label="AFTER MVP | kanban sprint concept map",labelloc=t];
 graph [rankdir=TB,bgcolor="#101827",pad=0.3,nodesep=0.5,ranksep=0.75,fontname="Arial",fontsize=21,label="Resumefolio | Work and Sprint concepts",labelloc=t];
 node [shape=box,style="rounded,filled",fillcolor="#1C3453",color="#9FB2CD",fontcolor="#F1F5F9",fontname="Arial",fontsize=14,margin="0.18,0.14"];
 edge [color="#9FB2CD",fontname="Arial",fontsize=12,fontcolor="#F1F5F9"];
 context [label="Authorized work context
Project / participant grants"];
 backlog [label="Product Backlog
List of identifiable Backlog Items"];
 item [label="Backlog Item
Feature / defect / improvement / investigation"];
 task [label="Tasks
Specific delivery activities
Assignment / priority / due date"];
 board [label="Board + configurable columns
Representation / state mapping pending",fillcolor="#49351C"];
 sprint [label="Sprint
Defined work period and goal",fillcolor="#382951"];
 sb [label="One Sprint Backlog
Sprint Goal + selected items
+ delivery plan",fillcolor="#173B34"];
 context -> backlog [label="defined scope"];
 backlog -> item [label="contains"];
 item -> task [label="may be refined into"];
 context -> board [label="authorized visualization"];
 context -> sprint [label="defined planning context"];
 item -> sb [label="selected work"];
 sprint -> sb [label="its goal and plan"];
 task -> sb [label="plan relationship if defined",style=dashed];

 graph [label="AFTER MVP | Advanced work and Sprint concepts",labelloc=t];
}
