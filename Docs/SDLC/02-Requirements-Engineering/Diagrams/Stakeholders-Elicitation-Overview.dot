// OWNER-MVP-2026-11-04 review: Method / document navigation. Scope-independent process/navigation; provider or runner examples are not MVP prerequisites.
digraph StakeholdersElicitation {
 graph [fontcolor="#F1F5F9"];
 edge [fontcolor="#F1F5F9"];
 graph [rankdir=TB,bgcolor="#101827",pad=0.35,ranksep=0.5,nodesep=0.4,fontname="Arial",fontsize=21,labelloc=t,
 label="Resumefolio | Stakeholders and elicitation\nActor context, planned work and actual evidence have separate roles"];
 node [shape=box,style="rounded,filled",fontname="Arial",fontsize=14,color="#9FB2CD",fontcolor="#F1F5F9",margin="0.22,0.16",fillcolor="#1C3453"];
 edge [color="#9FB2CD",arrowsize=0.7,fontname="Arial",fontsize=12];
 sources [label="ACCEPTED PLANNING / SOURCE MATERIAL\nScope, objectives and exact source context",fillcolor="#31577D",fontcolor=white];
 actors [label="ACTORS AND SYSTEM CONTEXT\nGoals, interactions, resource contexts\nExternal dependencies and open boundaries"];
 plan [label="ELICITATION PLAN AND TECHNIQUES\nGenuine gaps, methods and preparation\nProposed activities - not performed sessions",fillcolor="#382951"];
 log [label="ELICITATION LOG\nActual activity + date + inspected material / participants\nRaw evidence, separate interpretation and review state",fillcolor="#49351C"];
 actual [label="EXISTING DOCUMENTARY EVIDENCE\nLOG-001 / EXT-001 through EXT-003\nParaphrases checked; interpretations pending review",fillcolor="#3C3020"];
 handoff [label="ANALYSIS / SPECIFICATION HANDOFF\nReviewed needs + explicit unresolved questions\nScenarios, definitions and traceability\nNo automatic requirement acceptance",fillcolor="#173B34"];
 sources -> actors;
 actors -> plan [label="identify gaps"];
 sources -> log [label="exact provenance"];
 plan -> log [label="after actual activity"];
 log -> actual [label="recorded evidence"];
 log -> handoff [label="handoff with explicit gaps"];
 {rank=same;actors;log;}
 {rank=same;plan;actual;}
}
